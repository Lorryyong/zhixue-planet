/* 编辑弹窗（从 check 页抽取，组件内样式隔离） */
.mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(20,24,45,.5);z-index:100;display:flex;align-items:center;justify-content:center;padding:32rpx}
.dialog{background:#fff;border-radius:28rpx;width:100%;max-height:88vh;overflow-y:auto;padding:32rpx}
.dlg-h{font-size:32rpx;font-weight:800;display:flex;justify-content:space-between;align-items:center;margin-bottom:24rpx;position:sticky;top:0;background:#fff;z-index:2;padding-bottom:12rpx}
.dlg-x{font-size:32rpx;color:var(--muted);padding:0 10rpx}
.field{margin-bottom:26rpx}
.field .lb{font-size:26rpx;color:#5a6180;font-weight:600;margin-bottom:12rpx}
.meta-3{display:flex;gap:20rpx}
.meta-3 .meta-col{flex:1;min-width:0}
.inp{width:100%;box-sizing:border-box;background:#f5f6fb;border:1rpx solid #e6e8f2;border-radius:14rpx;padding:22rpx 20rpx;font-size:28rpx;line-height:1.6;min-height:88rpx;color:#2b3050}
.opt-row{display:flex;align-items:center;gap:12rpx;margin-bottom:10rpx}
.opt-key{flex:0 0 56rpx;height:56rpx;line-height:56rpx;text-align:center;border-radius:14rpx;background:#f0f1f8;color:#5a6180;font-weight:700;font-size:26rpx}
.opt-key.sel{background:var(--brand);color:#fff}
.opt-inp{flex:1}
.picker-val{background:#f5f6fb;border:1rpx solid #e6e8f2;border-radius:14rpx;padding:22rpx 20rpx;font-size:28rpx;min-height:88rpx;line-height:1.6;color:#2b3050}
.blank-lb{flex:0 0 100rpx;font-size:26rpx;color:var(--muted)}
.pt-edit{display:flex;gap:12rpx;margin-bottom:14rpx;align-items:center}
.pt-name{flex:1}
.pt-score{flex:0 0 140rpx}
.kp-tip{font-size:21rpx;color:#98a0b8;line-height:1.5;margin:-4rpx 0 12rpx}
.kp-edit-row{display:flex;align-items:center;gap:10rpx;margin-bottom:12rpx}
.kp-edit-name{flex:1;min-width:0}
.kp-edit-book{flex:0 0 220rpx;min-height:88rpx;padding:22rpx 14rpx;font-size:23rpx;text-align:center}
.kp-del{flex:0 0 40rpx;text-align:center;color:#d9483b;font-size:28rpx;padding:8rpx}
.dialog .save-edit{position:sticky;bottom:0;margin-top:12rpx}
