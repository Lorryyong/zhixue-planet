/* 全局样式 */
page {
  --brand: #5b6cf6;
  --brand2: #8a5cf6;
  --mint: #22c7a9;
  --amber: #ffb020;
  --red: #ff5c6c;
  --ink: #1f2540;
  --muted: #6e7694;
  --line: #ececf4;
  --soft: #f5f6fb;
  background: var(--soft);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: var(--ink);
}

.wrap { padding: 24rpx 28rpx 160rpx; }
.hdr { display: flex; align-items: center; justify-content: space-between; margin: 8rpx 0 28rpx; }
.hi { font-size: 40rpx; font-weight: 800; letter-spacing: -1rpx; }
.hi .small { display: block; font-size: 22rpx; color: var(--muted); font-weight: 500; margin-top: 4rpx; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: linear-gradient(135deg, var(--brand), var(--brand2)); display: flex; align-items: center; justify-content: center; font-size: 40rpx; color: #fff; }

.card { background: #fff; border-radius: 32rpx; padding: 30rpx; box-shadow: 0 8rpx 30rpx rgba(40,45,90,.06); margin-bottom: 24rpx; }
.tag { display: inline-block; font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 14rpx; background: #eef0ff; color: var(--brand); font-weight: 600; }
.tag.g { background: #e4faf4; color: #12987f; }
.tag.y { background: #fff3de; color: #c78310; }
.tag.r { background: #ffe9ec; color: #e04656; }
.sec-t { font-size: 28rpx; font-weight: 800; margin: 8rpx 0 22rpx; }
.btn { border: none; border-radius: 26rpx; padding: 26rpx 36rpx; font-size: 30rpx; font-weight: 700; color: #fff; background: linear-gradient(90deg, var(--brand), var(--brand2)); width: 100%; box-shadow: 0 10rpx 28rpx rgba(91,108,246,.3); }
.btn.ghost { background: #eef0ff; color: var(--brand); box-shadow: none; }
.btn.mini { width: auto; padding: 16rpx 28rpx; font-size: 24rpx; }
.hint { font-size: 22rpx; color: var(--muted); text-align: center; margin-top: 14rpx; line-height: 1.6; }
