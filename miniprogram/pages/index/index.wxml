<view class="wrap">
  <view class="hdr">
    <view class="hi">{{greeting}}，{{nickname}} 👋<text class="small">今天也要打卡赚能量哦</text></view>
    <image wx:if="{{avatar}}" class="avatar avatar-img" src="{{avatar}}" mode="aspectFill"></image>
    <view wx:else class="avatar">🧑‍🎓</view>
  </view>

  <view class="hero">
    <view class="planet">🪐</view>
    <view class="name">🏆 打卡排名</view>
    <view class="rank-sub">按累计获得能量排序 · 农场消费不扣减</view>
    <scroll-view wx:if="{{rankRows.length}}" scroll-y class="rank-scroll" style="height:{{rankScrollH}}rpx">
      <view wx:for="{{rankRows}}" wx:key="studentId" class="rank-row {{item.isMe ? 'me' : ''}} {{item.rank === 1 ? 'r1' : (item.rank === 2 ? 'r2' : (item.rank === 3 ? 'r3' : ''))}}">
        <text class="rank-no">{{item.medal || item.rank}}</text>
        <image wx:if="{{item.avatar}}" class="rank-av" src="{{item.avatar}}" mode="aspectFill"></image>
        <view wx:else class="rank-av rank-av-t">🧑‍🎓</view>
        <text class="rank-name">{{item.nickname}}<text wx:if="{{item.isMe}}" class="me-tag">我</text></text>
        <text class="rank-streak">🔥{{item.streak}}天</text>
        <text class="rank-energy">⚡{{item.totalEarned}}</text>
      </view>
    </scroll-view>
    <view wx:else class="rank-empty">暂无排名数据，完成一次打卡后即可上榜</view>
    <view wx:if="{{myRank}}" class="rank-mybar">我的排名：第 {{myRank}} 名 · 累计获得 ⚡{{myTotalEarned}}</view>
  </view>

  <view class="stat3">
    <view class="card s" bindtap="goEnergy"><text class="b">{{streak}}</text><text class="sp">连续打卡</text></view>
    <view class="card s" bindtap="goStudyCard"><text class="b">{{acc}}%</text><text class="sp">本周正确率</text></view>
    <view class="card s"><text class="b">{{conquered}}</text><text class="sp">攻克错题</text></view>
  </view>

  <view class="sec-t">📌 今日任务 <text class="tag">{{taskSubject || subject}}</text> <text class="tag">{{taskCount}} 题</text></view>
  <view class="subj-tabs">
    <view wx:for="{{subjects}}" wx:key="name" class="subj {{subject === item.name ? 'on' : ''}} {{item.done ? 'done' : ''}}" data-s="{{item.name}}" bindtap="onSubjectTap">{{item.name}}<text wx:if="{{item.done}}" class="ck">✓</text></view>
  </view>
  <view wx:if="{{taskDone}}" class="card done">
    <view class="emoji">🎉</view>
    <view class="dt">{{taskSubject || subject}} · 今日已打卡</view>
    <view class="hint">答对 {{last.correct}}/{{last.total}} 题 · 获得 {{last.energy}} 能量</view>
    <button class="btn ghost" style="margin-top:24rpx" bindtap="goWrong">去错题本看看 ›</button>
  </view>
  <view wx:else class="card">
    <view class="task-item">
      <view class="ci" style="background:#ffe9ec">🔁</view>
      <view class="tx"><view class="b">到期错题重刷</view><view class="sp">艾宾浩斯到期错题 · 优先重刷巩固</view></view>
      <text class="tag r">{{wrongCount}} 题</text>
    </view>
    <view class="task-item">
      <view class="ci" style="background:#e4faf4">✅</view>
      <view class="tx"><view class="b">题库巩固练习</view><view class="sp">从已勾选启用题库选取 · 补齐题量</view></view>
      <text class="tag g">{{bankCount}} 题</text>
    </view>
    <button class="btn start-btn" style="margin-top:24rpx" disabled="{{taskCount === 0}}" bindtap="startQuiz">{{taskCount > 0 ? '开始今日打卡 +20⚡' : '本科目暂无可打卡题目'}}</button>
  </view>
</view>