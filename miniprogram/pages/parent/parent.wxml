<view class="wrap">
  <view class="hd">
    <view class="hi">家长绑定与周报订阅<text class="small">云端同步，家长可查看孩子真实学情</text></view>
  </view>

  <!-- ============ 家长：认领孩子 ============ -->
  <view class="card">
    <view class="sec-t">认领孩子</view>
    <view class="bind-tip">在孩子的「个人资料」页获取 6 位家长绑定码，输入并选择你和学生的关系即可认领，查看其学情周报。</view>
    <view class="field">
      <view class="lb">6 位绑定码</view>
      <input class="inp code-inp" type="number" value="{{inputCode}}" bindinput="onCode" placeholder="输入孩子提供的绑定码" maxlength="6" />
    </view>
    <view class="field">
      <view class="lb">我和学生的关系</view>
      <picker mode="selector" range="{{relations}}" value="{{relationIndex}}" bindchange="onRelation">
        <view class="inp picker-inp"><text>{{relation}}</text><text class="picker-arrow">▾</text></view>
      </picker>
    </view>
    <button class="btn primary full" loading="{{loading}}" bindtap="claim">认领孩子</button>
  </view>

  <!-- ============ 已认领的孩子 ============ -->
  <view class="card" wx:if="{{children.length}}">
    <view class="sec-t">我的孩子</view>
    <view class="child-list">
      <view wx:for="{{children}}" wx:key="openid" class="child-item {{activeChild === item.openid ? 'on' : ''}}" data-id="{{item.openid}}" bindtap="selectChild">
        <view class="ci-ic">🧒</view>
        <text class="ci-name">{{item.nickname || '孩子'}}</text>
        <text class="ci-rel" wx:if="{{item.relation}}">我是{{item.relation}}</text>
        <text class="ci-check" wx:if="{{activeChild === item.openid}}">✓</text>
      </view>
    </view>
  </view>

  <!-- ============ 学情周报 ============ -->
  <view class="sec-t">
    孩子学情周报
    <text wx:if="{{reportWeek}}" class="week-tag">{{reportWeek}}</text>
  </view>
  <view class="card" wx:if="{{report && report.hasData}}">
    <view class="stat-grid">
      <view class="stat"><view class="st-n">{{report.energy}}</view><view class="st-l">累计能量</view></view>
      <view class="stat"><view class="st-n">{{report.streak}}</view><view class="st-l">连续打卡</view></view>
      <view class="stat"><view class="st-n">{{report.acc}}%</view><view class="st-l">正确率</view></view>
      <view class="stat"><view class="st-n">{{report.conquered}}</view><view class="st-l">攻克错题</view></view>
    </view>
    <view class="report-foot">本周答题 {{report.answerCount}} 道 · 本周打卡 {{report.checkins}} 天 · 待攻克错题 {{report.wrongActive}} 道</view>
    <view class="weak-t">需重点关注的知识点</view>
    <view wx:if="{{report.weakList.length}}" class="weak-list">
      <view class="weak-row" wx:for="{{report.weakList}}" wx:key="id">
        <text class="wk-name">{{item.name}}</text>
        <view class="wk-bar"><view class="wk-fill" style="width:{{item.score}}%"></view></view>
        <text class="wk-score">{{item.score}}%</text>
      </view>
    </view>
    <view wx:else class="empty">暂无薄弱知识点，继续保持 🎉</view>
    <view class="refresh-link" bindtap="refreshReport">刷新周报 ›</view>
  </view>
  <view wx:else class="card"><view class="empty">{{children.length ? '孩子完成几次打卡后，这里会生成本周学情周报' : '认领孩子后，这里会显示孩子的学情周报'}}</view></view>

  <view class="hint">监护人信息与周报仅用于本小程序内的学习反馈，数据存于云端并受《隐私与未成年人保护》条款保护，不会向第三方披露。</view>

  <!-- 解除绑定：页面最底部，仅在已认领孩子时出现，解除与当前选中孩子的绑定 -->
  <view wx:if="{{activeChild}}" class="unbind-link" bindtap="unclaim">解除绑定</view>
</view>
