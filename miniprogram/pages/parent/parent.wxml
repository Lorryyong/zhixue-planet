<view class="wrap">
  <view class="hd">
    <view class="hi">👨‍👩‍👧 家长绑定与周报<text class="small">云端同步，家长可查看孩子真实学情</text></view>
  </view>

  <!-- 视角切换 -->
  <view class="seg">
    <view class="seg-i {{mode === 'student' ? 'on' : ''}}" data-mode="student" bindtap="setMode">我是学生</view>
    <view class="seg-i {{mode === 'parent' ? 'on' : ''}}" data-mode="parent" bindtap="setMode">我是家长</view>
  </view>

  <!-- ============ 学生视角 ============ -->
  <block wx:if="{{mode === 'student'}}">
    <!-- 已绑定状态 -->
    <view wx:if="{{bound}}" class="card bind-card">
      <view class="bc-top">
        <view class="bc-avatar">👪</view>
        <view class="bc-info">
          <view class="bc-name">{{guardian}} <text class="rel">{{relation}}</text></view>
          <view class="bc-sub">{{phone ? '📱 ' + phone : '未留手机号'}} · 已绑定 {{boundAt}}</view>
        </view>
        <view class="bc-ok">✓</view>
      </view>
      <view class="code-box" wx:if="{{code}}">
        <view class="code-l">🔑 家长绑定码（告诉家长，在「我是家长」中输入认领）</view>
        <view class="code-v" bindtap="copyCode">{{code}} <text class="code-copy">点击复制</text></view>
      </view>
      <view class="bind-tip">{{claimed ? '家长已认领，可查看你的学情周报。' : '等待家长用绑定码认领后即可查看周报。'}}</view>
      <button class="btn ghost mini" bindtap="unbind">解除绑定</button>
    </view>

    <!-- 绑定表单 -->
    <view wx:else class="card">
      <view class="sec-t">绑定监护人</view>
      <view class="field">
        <view class="lb">监护人称呼</view>
        <input class="inp" value="{{inputGuardian}}" bindinput="onGuardian" placeholder="如：妈妈 / 张女士" maxlength="12" />
      </view>
      <view class="field">
        <view class="lb">与孩子的关系</view>
        <picker mode="selector" range="{{relations}}" value="{{relationIndex}}" bindchange="onRelation">
          <view class="inp picker-inp"><text>{{relation}}</text><text class="picker-arrow">▾</text></view>
        </picker>
      </view>
      <view class="field">
        <view class="lb">手机号（选填，用于找回与通知）</view>
        <input class="inp" type="number" value="{{inputPhone}}" bindinput="onPhone" placeholder="11位手机号" maxlength="11" />
      </view>
    </view>

    <!-- 周报订阅 -->
    <view class="card">
      <view class="sec-t">📬 学习周报订阅</view>
      <view class="switch-row">
        <view class="switch-info">
          <view class="sw-t">每周学习周报</view>
          <view class="sw-d">每周自动汇总打卡、正确率与薄弱知识点</view>
        </view>
        <switch checked="{{weekly}}" bindchange="onWeekly" color="#5b6cf6" />
      </view>
      <view class="field" wx:if="{{weekly}}">
        <view class="lb">接收日</view>
        <picker mode="selector" range="{{weekDays}}" value="{{weekDayIndex}}" bindchange="onWeekDay">
          <view class="inp picker-inp"><text>每周{{weeklyDay}}</text><text class="picker-arrow">▾</text></view>
        </picker>
      </view>
      <button wx:if="{{bound && weekly}}" class="btn mini" bindtap="saveSubscription">保存订阅设置</button>
    </view>

    <button class="btn primary save-btn" wx:if="{{!bound}}" loading="{{saving}}" bindtap="bind">确认绑定</button>
  </block>

  <!-- ============ 家长视角 ============ -->
  <block wx:else>
    <view class="card">
      <view class="sec-t">认领孩子</view>
      <view class="bind-tip">在孩子的小程序「我是学生」页获取 6 位绑定码，输入即可认领并查看其学情周报。</view>
      <view class="field">
        <view class="lb">6 位绑定码</view>
        <input class="inp code-inp" type="number" value="{{inputCode}}" bindinput="onCode" placeholder="输入孩子提供的绑定码" maxlength="6" />
      </view>
      <button class="btn primary full" loading="{{loading}}" bindtap="claim">认领孩子</button>
    </view>
    <view class="card" wx:if="{{children.length}}">
      <view class="sec-t">我的孩子</view>
      <view class="child-list">
        <view wx:for="{{children}}" wx:key="openid" class="child-item {{activeChild === item.openid ? 'on' : ''}}" data-id="{{item.openid}}" bindtap="selectChild">
          <text class="ci-emoji">🧒</text>
          <text class="ci-name">{{item.guardian || '孩子'}}（{{item.relation}}）</text>
          <text class="ci-check" wx:if="{{activeChild === item.openid}}">✓</text>
        </view>
      </view>
    </view>
  </block>

  <!-- ============ 学情周报 ============ -->
  <view class="sec-t">
    📊 {{mode === 'parent' ? '孩子学情周报' : '我的学情周报'}}
    <text wx:if="{{reportWeek}}" class="week-tag">{{reportWeek}}</text>
  </view>
  <view class="card" wx:if="{{report && report.hasData}}">
    <view class="stat-grid">
      <view class="stat"><view class="st-n">{{report.energy}}</view><view class="st-l">累计能量</view></view>
      <view class="stat"><view class="st-n">{{report.streak}}</view><view class="st-l">连续打卡</view></view>
      <view class="stat"><view class="st-n">{{report.acc}}%</view><view class="st-l">正确率</view></view>
      <view class="stat"><view class="st-n">{{report.conquered}}</view><view class="st-l">攻克错题</view></view>
    </view>
    <view class="report-foot">本周答题 {{report.answerCount}} 道 · 本周打卡 {{report.checkins}} 天 · 待攻克错题 {{report.wrongActive}} 道</view>
    <view class="weak-t">📌 需重点关注的知识点</view>
    <view wx:if="{{report.weakList.length}}" class="weak-list">
      <view class="weak-row" wx:for="{{report.weakList}}" wx:key="id">
        <text class="wk-name">{{item.name}}</text>
        <view class="wk-bar"><view class="wk-fill" style="width:{{item.score}}%"></view></view>
        <text class="wk-score">{{item.score}}%</text>
      </view>
    </view>
    <view wx:else class="empty">暂无薄弱知识点，继续保持 🎉</view>
    <button class="btn ghost mini full refresh-btn" bindtap="refreshReport">🔄 刷新最新周报</button>
  </view>
  <view wx:else class="card"><view class="empty">完成几次打卡后，这里会生成本周学情周报</view></view>

  <view class="hint">监护人信息与周报仅用于本小程序内的学习反馈，数据存于云端并受《隐私与未成年人保护》条款保护，不会向第三方披露。</view>
</view>
