.wrap{padding:32rpx}
.hd{margin-bottom:28rpx}
.hd-t{font-size:40rpx;font-weight:900;color:#232845}
.hd-s{font-size:24rpx;color:var(--muted);margin-top:10rpx;line-height:1.6}
.card{background:#fff;border-radius:26rpx;padding:32rpx;box-shadow:0 6rpx 24rpx rgba(91,108,246,.06)}

.avatar-row{display:flex;align-items:center;justify-content:center;padding:8rpx 0 32rpx;border-bottom:2rpx solid var(--line)}
.avatar-btn{position:relative;width:180rpx;height:180rpx;padding:0;border-radius:50%;overflow:visible;background:transparent;line-height:1}
.avatar-btn::after{border:none}
.avatar-img{width:180rpx;height:180rpx;border-radius:50%;display:block;background:#eef0f8}
.avatar-ph{width:180rpx;height:180rpx;border-radius:50%;background:linear-gradient(135deg,#eef0ff,#e4e9ff);color:#7c86c9;font-size:88rpx;display:flex;align-items:center;justify-content:center}
.avatar-edit{position:absolute;right:0;bottom:0;width:56rpx;height:56rpx;border-radius:50%;background:#5b6cf6;color:#fff;font-size:30rpx;display:flex;align-items:center;justify-content:center;border:4rpx solid #fff;box-shadow:0 4rpx 12rpx rgba(91,108,246,.3);line-height:1}

.field{margin-top:28rpx}
.field .lb{font-size:24rpx;font-weight:600;color:var(--muted);margin-bottom:14rpx}
.inp{background:#f5f6fb;border:2rpx solid #e6e8f2;border-radius:16rpx;padding:28rpx 24rpx;font-size:34rpx;line-height:1.4;color:#2b3050;width:100%;box-sizing:border-box}
/* 原生 input 必须给足高度并与字号匹配，否则真机上文字会被垂直裁切、看不见输入内容 */
input.inp{height:104rpx;line-height:104rpx;padding-top:0;padding-bottom:0}
/* 家长绑定码独立卡 */
.bind-card{margin-top:24rpx}
.bind-hd{display:flex;align-items:center;justify-content:space-between}
.bind-t{font-size:28rpx;font-weight:800;color:#232845}
.bind-copy{font-size:23rpx;font-weight:700;color:var(--brand);background:#eef0ff;border-radius:999rpx;padding:9rpx 26rpx}
.bind-code{font-size:52rpx;font-weight:800;color:var(--brand);letter-spacing:10rpx;margin-top:16rpx}
.bind-code.dim{color:#9aa2bf;font-size:26rpx;letter-spacing:0}
.bind-hint{font-size:22rpx;color:#98a0b8;margin-top:12rpx;line-height:1.6}
.picker-inp{display:flex;align-items:center;justify-content:space-between}
.picker-arrow{font-size:30rpx;color:#9aa2bf}
.field-hint{font-size:22rpx;color:#98a0b8;margin-top:10rpx;line-height:1.5}
.role-field{display:flex;align-items:center;justify-content:space-between}
.role-field .lb{margin-bottom:0}
.role-val{font-size:26rpx;color:#5b6cf6;font-weight:700}

.tip{font-size:22rpx;color:#98a0b8;line-height:1.7;margin:28rpx 8rpx}
.save-btn{margin-top:12rpx}
.skip-btn{margin-top:20rpx}
