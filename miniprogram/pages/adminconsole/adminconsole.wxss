.hdr{margin:8rpx 0 24rpx}
.hi{font-size:34rpx;font-weight:800}
.hi small{display:block;font-size:22rpx;color:var(--muted);font-weight:500;margin-top:6rpx}
.sec-t{font-size:28rpx;font-weight:800;margin:28rpx 0 14rpx}
.hint{font-size:21rpx;color:var(--muted);line-height:1.6}
.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:20rpx}
.login-card{text-align:center;padding:48rpx 32rpx}
.lock-ic{width:110rpx;height:110rpx;border-radius:32rpx;background:#eef0ff;display:flex;align-items:center;justify-content:center;font-size:54rpx;margin:0 auto}
.login-t{font-size:34rpx;font-weight:800;margin:12rpx 0 6rpx}
.login-s{font-size:22rpx;color:var(--muted);margin-bottom:30rpx}
.field{text-align:left;margin-bottom:24rpx}
.field .lb{font-size:25rpx;color:#5a6180;font-weight:600;margin-bottom:10rpx}
.inp{width:100%;box-sizing:border-box;background:#f5f6fb;border:1rpx solid #e6e8f2;border-radius:14rpx;padding:22rpx 20rpx;font-size:28rpx;min-height:88rpx;color:#2b3050}
.userbar{display:flex;align-items:center;justify-content:space-between;background:#e4faf4;border-radius:18rpx;padding:20rpx 24rpx;margin-bottom:12rpx}
.userbar .ok{font-size:26rpx;color:#12987f;font-weight:700}
.mi{display:flex;align-items:center;gap:18rpx;padding:26rpx 4rpx;font-size:28rpx;border-bottom:1rpx solid var(--line)}
.mi:last-child{border-bottom:none}
.mi-ic{width:72rpx;height:72rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;font-size:32rpx;flex-shrink:0}
.mi .ar{margin-left:auto;color:var(--muted);font-size:32rpx}
.acct{display:flex;align-items:center;justify-content:space-between;padding:18rpx 4rpx;border-bottom:1rpx solid var(--line)}
.acct:last-child{border-bottom:none}
.acct-name{font-size:28rpx;font-weight:600}
.tag{font-size:20rpx;background:var(--soft);color:var(--muted);border-radius:10rpx;padding:6rpx 14rpx}
.tag.builtin{background:#fff3e6;color:#c07d2c}
.lock-img{width:54rpx;height:54rpx}
.idcard{display:flex;align-items:center;gap:20rpx}
.id-av{width:96rpx;height:96rpx;border-radius:28rpx;flex-shrink:0}
.id-av-ph{background:#eef0ff;display:flex;align-items:center;justify-content:center}
.id-av-img{width:48rpx;height:48rpx}
.id-info{flex:1;min-width:0}
.id-name{font-size:30rpx;font-weight:800;display:flex;align-items:center;gap:12rpx}
.id-sub{font-size:22rpx;color:var(--muted);margin-top:6rpx}
.tag.kind{background:#eef0ff;color:var(--brand)}
.stats{display:flex;padding:24rpx 0}
.stat{flex:1;text-align:center}
.stat-n{font-size:36rpx;font-weight:800}
.stat-l{font-size:21rpx;color:var(--muted);margin-top:4rpx}
.grid{display:flex;flex-wrap:wrap;gap:20rpx;margin-bottom:8rpx}
.g-item{position:relative;width:calc(50% - 10rpx);box-sizing:border-box;background:#fff;border-radius:24rpx;padding:26rpx}
.g-ic{width:76rpx;height:76rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center}
.g-img{width:40rpx;height:40rpx}
.g-t{font-size:28rpx;font-weight:700;margin-top:16rpx}
.g-d{font-size:21rpx;color:var(--muted);margin-top:4rpx}
.g-badge{position:absolute;top:20rpx;right:20rpx;min-width:36rpx;height:36rpx;border-radius:18rpx;background:var(--red);color:#fff;font-size:20rpx;font-weight:700;display:flex;align-items:center;justify-content:center;padding:0 8rpx}
.acct-main{flex:1;min-width:0}
.acct-sub{font-size:20rpx;color:var(--muted);margin-top:4rpx}
.acct-cancel{font-size:24rpx;color:var(--red);padding:8rpx 0 8rpx 16rpx;flex-shrink:0}
.danger-link{text-align:center;color:var(--red);font-size:26rpx;padding:20rpx 0 4rpx}
