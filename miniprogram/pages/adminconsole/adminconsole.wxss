.hdr{margin:8rpx 0 24rpx}
.hi{font-size:34rpx;font-weight:800}
.hi small{display:block;font-size:22rpx;color:var(--muted);font-weight:500;margin-top:6rpx}
.sec-t{font-size:28rpx;font-weight:800;margin:28rpx 0 14rpx}
.hint{font-size:21rpx;color:var(--muted);line-height:1.6}
.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:20rpx}
.login-card{text-align:center;padding:48rpx 32rpx}
.lock{font-size:80rpx}
.login-t{font-size:34rpx;font-weight:800;margin:12rpx 0 6rpx}
.login-s{font-size:22rpx;color:var(--muted);margin-bottom:30rpx}
.field{text-align:left;margin-bottom:24rpx}
.field .lb{font-size:25rpx;color:#5a6180;font-weight:600;margin-bottom:10rpx}
.inp{width:100%;box-sizing:border-box;background:#f5f6fb;border:1rpx solid #e6e8f2;border-radius:14rpx;padding:22rpx 20rpx;font-size:28rpx;min-height:88rpx;color:#2b3050}
.userbar{display:flex;align-items:center;justify-content:space-between;background:#e4faf4;border-radius:18rpx;padding:20rpx 24rpx;margin-bottom:12rpx}
.userbar .ok{font-size:26rpx;color:#12987f;font-weight:700}
.mi{display:flex;align-items:center;gap:18rpx;padding:26rpx 4rpx;font-size:28rpx;border-bottom:1rpx solid var(--line)}
.mi:last-child{border-bottom:none}
.mi .ic{font-size:36rpx}
.mi .ar{margin-left:auto;color:var(--muted);font-size:32rpx}
.acct{display:flex;align-items:center;justify-content:space-between;padding:18rpx 4rpx;border-bottom:1rpx solid var(--line)}
.acct:last-child{border-bottom:none}
.acct-name{font-size:28rpx;font-weight:600}
.tag{font-size:20rpx;background:var(--soft);color:var(--muted);border-radius:10rpx;padding:6rpx 14rpx}
.tag.builtin{background:#fff3e6;color:#c07d2c}
