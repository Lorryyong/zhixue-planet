.quiz-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx}
.quiz-top .c{font-size:26rpx;color:var(--muted)}
.quiz-top .c .b{color:var(--ink);font-size:32rpx;font-weight:800}
.quiz-prog{height:14rpx;background:var(--line);border-radius:14rpx;overflow:hidden;margin-bottom:36rpx}
.quiz-prog .fill{height:100%;background:linear-gradient(90deg,var(--brand),var(--mint));border-radius:14rpx;transition:.3s}
.quiz-stem{font-size:32rpx;font-weight:600;line-height:1.6;margin-bottom:36rpx}
.opt{border:4rpx solid var(--line);border-radius:26rpx;padding:26rpx 30rpx;margin-bottom:20rpx;display:flex;align-items:center;gap:22rpx;font-size:28rpx;background:#fff}
.opt .k{width:54rpx;height:54rpx;border-radius:50%;background:var(--soft);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--muted);flex-shrink:0}
.opt.sel{border-color:var(--brand);background:#f4f5ff}
.opt.sel .k{background:var(--brand);color:#fff}
.opt.right{border-color:var(--mint);background:#e4faf4}
.opt.right .k{background:var(--mint);color:#fff}
.opt.wrong{border-color:var(--red);background:#ffe9ec}
.opt.wrong .k{background:var(--red);color:#fff}
.opt-text{flex:1}
.multi-ck{width:40rpx;height:40rpx;border-radius:50%;background:var(--brand);color:#fff;display:flex;align-items:center;justify-content:center;font-size:24rpx;flex-shrink:0}
.tag.qtype{background:#eef0ff;color:var(--brand)}
.hint{font-size:22rpx;color:var(--muted)}
.blank-row{display:flex;align-items:center;gap:18rpx;margin-bottom:20rpx}
.blank-no{font-size:24rpx;color:var(--muted);width:110rpx;flex-shrink:0}
.blank-inp{flex:1;border:4rpx solid var(--line);border-radius:20rpx;padding:20rpx 24rpx;font-size:28rpx;background:#fff}
.subj-label{font-size:24rpx;color:var(--muted);margin-bottom:14rpx}
.subj-area{width:100%;box-sizing:border-box;border:4rpx solid var(--line);border-radius:24rpx;padding:24rpx;font-size:28rpx;line-height:1.7;background:#fff;min-height:240rpx}
.fb-a{font-size:26rpx;line-height:1.6;word-break:break-all}
.feedback{border-radius:26rpx;padding:26rpx;font-size:26rpx;line-height:1.6;margin-bottom:20rpx}
.feedback.ok{background:#e4faf4;color:#0e7c68}
.feedback.no{background:#ffe9ec;color:#c23b4a}
.fb-t{font-weight:800;margin-bottom:8rpx}
.fb-score{font-size:24rpx;font-weight:700;margin-bottom:6rpx}
.fb-ai{font-size:24rpx;margin-bottom:8rpx;opacity:.9}
.fb-d{font-size:22rpx;margin-top:12rpx;opacity:.85}
/* 自评弹窗 */
.mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(20,24,45,.55);display:flex;align-items:center;justify-content:center;z-index:99;padding:40rpx}
.dialog{width:100%;background:#fff;border-radius:30rpx;padding:36rpx;max-height:86vh;overflow-y:auto}
.dlg-h{font-size:32rpx;font-weight:800;margin-bottom:24rpx;display:flex;justify-content:space-between}
.dlg-x{color:var(--muted)}
.field{margin-bottom:22rpx}
.lb{font-size:24rpx;color:var(--muted);margin-bottom:10rpx}
.ref-box{font-size:27rpx;line-height:1.7;background:var(--soft);border-radius:18rpx;padding:20rpx}
.pt-row{font-size:25rpx;line-height:1.7;padding:6rpx 0}
.self-btns{display:flex;gap:20rpx}
.self-btns .btn{flex:1}
.card.fin{text-align:center;padding:50rpx}
.card.fin .emoji{font-size:84rpx}
.card.fin .dt{font-size:34rpx;font-weight:800;margin-top:16rpx}