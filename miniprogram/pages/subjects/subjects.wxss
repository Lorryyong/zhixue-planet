.hd{margin:8rpx 0 20rpx}
.section{margin-bottom:28rpx}
.sec-title{display:flex;align-items:center;gap:10rpx;font-size:32rpx;font-weight:800;color:var(--ink);margin:4rpx 0 18rpx}
.sec-ic{font-size:34rpx}
.tip-bar{font-size:22rpx;color:#a8762a;background:linear-gradient(135deg,#fff6e8,#fff0f3);border:2rpx solid #f5dfb8;border-radius:18rpx;padding:18rpx 22rpx;line-height:1.6;margin-bottom:20rpx}
.card{background:#fff;border:2rpx solid var(--line);border-radius:20rpx;padding:8rpx 24rpx}
.sub-row{display:flex;align-items:center;justify-content:space-between;padding:22rpx 0;border-bottom:2rpx solid var(--line)}
.sub-row:last-child{border-bottom:none}
.sub-check{display:flex;align-items:center;gap:20rpx;flex:1}
.box{width:40rpx;height:40rpx;border-radius:12rpx;border:3rpx solid #c9cfe0;display:flex;align-items:center;justify-content:center;color:#fff;font-size:26rpx;font-weight:800;flex-shrink:0}
.sub-row.on .box{background:var(--brand);border-color:var(--brand)}
.sub-name{font-size:30rpx;font-weight:600}
.sub-row:not(.on) .sub-name{color:var(--muted)}
.ver-pick{font-size:24rpx;color:var(--brand);background:#eef0ff;padding:12rpx 20rpx;border-radius:16rpx;font-weight:600}
.ver-pick .ar{margin-left:8rpx}
.ver-off{font-size:22rpx;color:#c3c9d8}

/* 打卡设置 */
.cfg-card{padding:4rpx 24rpx}
.cfg-row{padding:24rpx 0;border-bottom:2rpx solid var(--line)}
.cfg-row:last-child{border-bottom:none}
.cfg-label{font-size:28rpx;font-weight:700;color:var(--ink);margin-bottom:18rpx;line-height:1.5}
.cfg-note{display:block;font-size:21rpx;font-weight:400;color:var(--muted);margin-top:6rpx}
.chips{display:flex;flex-wrap:wrap;gap:14rpx}
.chip{font-size:24rpx;color:#5a6180;background:#f2f3f9;border:2rpx solid #e6e8f2;border-radius:14rpx;padding:14rpx 22rpx;font-weight:600}
.chip.on{color:#fff;background:var(--brand);border-color:var(--brand)}
.plans{display:flex;flex-direction:column;gap:14rpx}
.plan{display:block;border:2rpx solid #e6e8f2;border-radius:16rpx;padding:18rpx 22rpx;background:#fafbff}
.plan.on{border-color:var(--brand);background:#eef0ff}
.plan-top{display:flex;align-items:center;justify-content:space-between}
.plan-name{font-size:27rpx;font-weight:700;color:var(--ink)}
.plan.on .plan-name{color:var(--brand)}
.plan-check{color:var(--brand);font-size:28rpx;font-weight:800}
.plan-gaps{font-size:22rpx;color:var(--muted);margin-top:8rpx}
.save-btn{margin-top:8rpx}
