.hd{margin:8rpx 0 20rpx}
.tip-bar{font-size:22rpx;color:#a8762a;background:linear-gradient(135deg,#fff6e8,#fff0f3);border:2rpx solid #f5dfb8;border-radius:18rpx;padding:18rpx 22rpx;line-height:1.6;margin-bottom:24rpx}
.sub-row{display:flex;align-items:center;justify-content:space-between;padding:22rpx 0;border-bottom:2rpx solid var(--line)}
.sub-row:last-child{border-bottom:none}
.sub-check{display:flex;align-items:center;gap:20rpx;flex:1}
.box{width:40rpx;height:40rpx;border-radius:12rpx;border:3rpx solid #c9cfe0;display:flex;align-items:center;justify-content:center;color:#fff;font-size:26rpx;font-weight:800;flex-shrink:0}
.sub-row.on .box{background:var(--brand);border-color:var(--brand)}
.sub-name{font-size:30rpx;font-weight:600}
.sub-row:not(.on) .sub-name{color:var(--muted)}
.ver-pick{font-size:24rpx;color:var(--brand);background:#eef0ff;padding:12rpx 20rpx;border-radius:16rpx;font-weight:600}
.ver-pick .ar{margin-left:8rpx}
.ver-off{font-size:22rpx;color:#c3c9d8}
.save-btn{margin-top:12rpx}
