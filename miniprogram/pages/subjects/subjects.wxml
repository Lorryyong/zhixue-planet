<!-- 自定义导航栏：返回由页面接管，未保存时弹「直接退出/保存退出」 -->
<view class="navbar" style="padding-top:{{statusBarHeight}}px">
  <view class="navbar-row">
    <view class="navbar-back" bindtap="onBack"><view class="navbar-arrow"></view></view>
    <view class="navbar-title">学习设置</view>
    <view class="navbar-ph"></view>
  </view>
</view>
<view style="height:{{statusBarHeight + 44}}px"></view>

<view class="wrap">
  <!-- 第一区：我的学科与教材（页面标题在自定义导航栏里，不再重复） -->
  <view class="section">
    <view class="sec-title">我的学科与教材<text class="sec-count">已选 {{selectedCount}} 科</text></view>
    <view class="card">
      <view class="card-tip">勾选的学科会出现在首页「今日打卡」中，可每天分科打卡。教材版本用于匹配对应课本的知识点。</view>
      <view class="sub-row {{item.checked ? 'on' : ''}}" wx:for="{{list}}" wx:key="name">
        <view class="sub-check" data-i="{{index}}" bindtap="onCheck">
          <view class="box">{{item.checked ? '✓' : ''}}</view>
          <view class="sub-name">{{item.name}}</view>
        </view>
        <picker wx:if="{{item.checked}}" mode="selector" range="{{item.versions}}" value="{{item.versionIndex}}" data-i="{{index}}" bindchange="onVersion">
          <view class="ver-pick">{{item.textbook}} <text class="ar">▾</text></view>
        </picker>
        <view wx:else class="ver-off">未启用</view>
      </view>
    </view>
  </view>

  <!-- 第二区：打卡设置 -->
  <view class="section">
    <view class="sec-title">打卡设置</view>

    <view class="card cfg-card">
      <!-- 每日题数 -->
      <view class="cfg-row">
        <view class="cfg-label">每天打卡题目数<text class="cfg-note">每日每科需要完成的题量</text></view>
        <view class="chips">
          <view wx:for="{{goalOptions}}" wx:key="*this" class="chip {{dailyGoal === item ? 'on' : ''}}" data-v="{{item}}" bindtap="onGoal">{{item}} 题</view>
        </view>
      </view>

      <!-- 组卷配比：错题 / 新题 / 已刷 三类推荐组合 -->
      <view class="cfg-row">
        <view class="cfg-label">组卷配比<text class="cfg-note">当前：错题 {{wrongRatio}}% · 新题 {{freshRatio}}% · 已刷 {{seenRatio}}%，每天组卷按此安排；新题永远优先挑没刷过的题</text></view>
        <view class="plans">
          <view wx:for="{{mixPresets}}" wx:key="key" class="plan {{mixKey === item.key ? 'on' : ''}}" data-k="{{item.key}}" bindtap="onMix">
            <view class="plan-top">
              <text class="plan-name">{{item.label}}</text>
              <text class="plan-check">{{mixKey === item.key ? '✓' : ''}}</text>
            </view>
            <view class="plan-gaps">错题 {{item.wrong}}% · 新题 {{item.fresh}}% · 已刷 {{item.seen}}% —— {{item.desc}}</view>
          </view>
        </view>
      </view>

      <!-- 复习频率 -->
      <view class="cfg-row">
        <view class="cfg-label">错题复习频率<text class="cfg-note">选一种节奏安排错题重刷</text></view>
        <view class="plans">
          <view wx:for="{{reviewPlans}}" wx:key="key" class="plan {{reviewPlan === item.key ? 'on' : ''}}" data-k="{{item.key}}" bindtap="onPlan">
            <view class="plan-top">
              <text class="plan-name">{{item.label}}</text>
              <text class="plan-check">{{reviewPlan === item.key ? '✓' : ''}}</text>
            </view>
            <view class="plan-gaps">{{item.desc}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <button class="btn primary save-btn" loading="{{saving}}" bindtap="save">保存设置</button>
  <view class="hint">设置保存在你的账号中，更换设备登录后自动同步。打卡设置将于下次组卷时生效。</view>
</view>
