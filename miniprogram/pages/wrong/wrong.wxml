<view class="wrap">
  <view class="hdr">
    <view class="hi">错题本<text class="small">共 {{totalCount}} 道 · 待重刷 {{dueCount}} 道 · 已攻克 {{conqueredCount}} 道</text></view>
  </view>

  <view wx:if="{{dueCount > 0}}" class="review-entry" bindtap="goReview">
    <view class="re-main">
      <view class="re-t">快速复习</view>
      <view class="re-s">{{dueCount}} 道错题已到期 · 过卡自评，节奏更快</view>
    </view>
    <view class="re-go">开始 ›</view>
  </view>

  <!-- 科目栏：分布与清单共用同一个选择，全页只出现一次 -->
  <scroll-view scroll-x class="rail" show-scrollbar="{{false}}">
    <view wx:for="{{subjectOptions}}" wx:key="*this" class="chip {{subject===item?'on':''}}" data-v="{{item}}" bindtap="onSubjectPick">{{item}}</view>
  </scroll-view>

  <!-- 错题分布 -->
  <view class="dist-card">
    <view class="dc-head">
      <text class="dc-t">错题分布</text>
      <text class="dc-s">{{subject}} · 未攻克 {{distTotal}} 道</text>
    </view>
    <canvas wx:if="{{distHasRadar}}" canvas-id="distRadar" class="dist-radar"></canvas>
    <view wx:if="{{distTotal}}" class="dist-rows">
      <view wx:for="{{distBars}}" wx:key="name" class="dist-row">
        <text class="dist-name">{{item.name}}</text>
        <view class="dist-bar"><view class="dist-fill" style="width:{{item.count * 100 / distMax}}%"></view></view>
        <text class="dist-cnt">{{item.count}} 题</text>
      </view>
      <view wx:if="{{distMore && !distExpanded}}" class="dist-more" bindtap="toggleDist">另有 {{distMore}} 个知识点 ›</view>
      <view wx:if="{{distExpanded && distMore}}" class="dist-more" bindtap="toggleDist">收起 ›</view>
    </view>
    <view wx:else class="hint">暂无未攻克错题，太棒了</view>
  </view>

  <!-- 错题清单 -->
  <view class="sec-row">
    <text class="sec-t2">错题清单</text>
    <text class="export-link" bindtap="printTip">导出错题册 ›</text>
  </view>

  <view class="seg">
    <view class="seg-i {{filterStatus===''?'on':''}}" data-v="" bindtap="onFilterStatus">全部</view>
    <view wx:for="{{statusOptions}}" wx:key="key" class="seg-i {{filterStatus===item.key?'on':''}}" data-v="{{item.key}}" bindtap="onFilterStatus">{{item.label}}</view>
  </view>

  <scroll-view scroll-x class="rail err-rail" show-scrollbar="{{false}}">
    <view class="chip {{filterError===''?'on':''}}" data-v="" bindtap="onFilterError">全部错因</view>
    <view wx:for="{{errorChips}}" wx:key="key" class="chip {{filterError===item.key?'on':''}}" data-v="{{item.key}}" bindtap="onFilterError">{{item.label}}</view>
  </scroll-view>

  <view class="list-card">
    <view wx:for="{{list}}" wx:key="qid" class="wrong-item" bindtap="openDetail" data-qid="{{item.qid}}">
      <view class="wi-ic" style="background:{{item.iconBg}}"><image wx:if="{{item.img}}" class="ic-img" src="{{item.img}}" mode="aspectFit"></image><text wx:else>{{item.icon}}</text></view>
      <view class="wi-main">
        <view class="wi-stem">{{item.stem}}</view>
        <view class="wi-meta">
          <text class="et-dot" style="background:{{item.etColor}}"></text>
          <text>{{item.errorLabel}} · 错 {{item.wrongCount}} 次 · 连对 {{item.continuousCorrect}}</text>
          <text class="dots"><text wx:for="{{item.dots}}" wx:for-item="d" wx:key="*this" class="dot {{d ? 'done' : ''}}"></text></text>
        </view>
      </view>
      <text wx:if="{{item.conquered}}" class="pill done">已攻克</text>
      <text wx:elif="{{item.due}}" class="pill due">待重刷</text>
      <text wx:else class="pill todo">{{item.dueLabel}}</text>
    </view>
    <view wx:if="{{!list.length}}" class="hint">暂无错题{{hasFilter ? '（试试切换筛选）' : ''}}</view>
  </view>

  <!-- 题目详情：底部弹层（解析默认折叠：先想后看） -->
  <view wx:if="{{detailOpen}}" class="mask" bindtap="closeDetail">
    <view class="dialog" catchtap="noop">
      <view class="dlg-h">
        <text class="dlg-t">题目解析</text>
        <text class="dlg-x" bindtap="closeDetail">✕</text>
      </view>
      <block wx:if="{{detail}}">
        <view class="d-sub">{{detail.subject}} · {{detail.qTypeLabel}} · {{detail.errorLabel}}<text wx:if="{{detail.original}}" class="d-orig"> · {{detail.original}}</text></view>
        <view class="d-stem">{{detail.stem}}</view>
        <view wx:if="{{detail.optText.length}}" class="d-opts">
          <view wx:for="{{detail.optText}}" wx:for-item="o" wx:key="*this">{{o}}</view>
        </view>
        <view wx:if="{{detail.pointsText}}" class="d-points">评分要点：{{detail.pointsText}}</view>
        <view wx:if="{{detail.tagNames.length}}" class="d-tags">
          <text wx:for="{{detail.tagNames}}" wx:for-item="t" wx:key="*this" class="ktag">{{t}}</text>
        </view>
        <view class="d-errtype">
          <view class="d-errtype-t">错因（点选可改，帮你对症复习）</view>
          <view class="d-errtype-chips">
            <view wx:for="{{errTypeOptions}}" wx:key="v" class="etchip {{detail.detailErrType === item.v ? 'on' : ''}}" data-v="{{item.v}}" bindtap="pickDetailErrorType">{{item.label}}</view>
          </view>
        </view>
        <view wx:if="{{showAnalysis}}" class="d-analysis">
          <view class="d-analysis-t">💡 解析</view>
          <view class="d-analysis-c">{{detail.analysis || '暂无解析，可在「试卷 → 校对」中补全本题解析。'}}</view>
        </view>
        <view wx:else class="d-analysis-hidden" bindtap="showAnalysisNow">先自己想一想，想好了点这里看解析 ›</view>
        <view class="d-stat">错 {{detail.wrongCount}} 次 · 连对 {{detail.continuousCorrect}} · {{detail.conquered ? '已攻克' : detail.dueLabel}}<text wx:if="{{detail.stabShort}}"> · {{detail.stabShort}}</text></view>
      </block>
      <button class="btn dlg-btn" bindtap="closeDetail">关闭</button>
    </view>
  </view>
</view>
