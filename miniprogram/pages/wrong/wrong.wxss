/* 错题本 · 现代风 v2：科目栏全页一处、分布 Top5 折叠、清单分段控件、详情底部弹层 */
.rail{white-space:nowrap;margin-bottom:20rpx}
.chip{display:inline-block;padding:13rpx 28rpx;border-radius:999rpx;background:#eceef6;color:var(--ink);font-size:25rpx;font-weight:600;margin-right:12rpx}
.chip.on{background:var(--brand);color:#fff}
.err-rail{margin:18rpx 0 20rpx}

/* 分布卡 */
.dist-card{background:#fff;border-radius:28rpx;box-shadow:0 10rpx 30rpx rgba(40,45,90,.06);padding:26rpx 28rpx;margin-bottom:34rpx;display:flex;flex-direction:column;align-items:center}
.dc-head{align-self:stretch;display:flex;align-items:baseline;justify-content:space-between;margin-bottom:6rpx}
.dc-t{font-size:30rpx;font-weight:800;color:var(--ink)}
.dc-s{font-size:23rpx;color:var(--muted)}
.dist-radar{width:300px;height:290px}
.dist-rows{align-self:stretch;margin-top:10rpx}
.dist-row{display:flex;align-items:center;gap:16rpx;padding:9rpx 0}
.dist-name{width:170rpx;font-size:24rpx;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dist-bar{flex:1;height:14rpx;background:#f0f1f6;border-radius:99rpx;overflow:hidden}
.dist-fill{height:100%;background:#ff5c6c;border-radius:99rpx;opacity:.75}
.dist-cnt{font-size:23rpx;color:var(--muted);width:76rpx;text-align:right}
.dist-more{text-align:center;font-size:24rpx;color:var(--brand);padding:14rpx 0 4rpx}
.hint{font-size:24rpx;color:var(--muted);text-align:center;padding:30rpx 0;line-height:1.6}

/* 清单头与控件 */
.sec-row{display:flex;align-items:baseline;justify-content:space-between;margin:2rpx 0 18rpx}
.sec-t2{font-size:31rpx;font-weight:800;color:var(--ink)}
.export-link{font-size:25rpx;color:var(--brand);font-weight:600}
.seg{display:flex;background:#eceef6;border-radius:999rpx;padding:6rpx}
.seg-i{flex:1;text-align:center;font-size:25rpx;font-weight:600;color:#6a7192;padding:13rpx 0;border-radius:999rpx}
.seg-i.on{background:#fff;color:var(--ink);font-weight:800;box-shadow:0 4rpx 14rpx rgba(40,45,90,.10)}

/* 清单 */
.list-card{background:#fff;border-radius:28rpx;box-shadow:0 10rpx 30rpx rgba(40,45,90,.06);padding:6rpx 28rpx}
.wrong-item{display:flex;gap:18rpx;align-items:flex-start;padding:24rpx 0;border-bottom:2rpx solid var(--line)}
.wrong-item:last-child{border-bottom:none}
.wi-ic{width:72rpx;height:72rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;font-size:34rpx;flex-shrink:0}
.wi-main{flex:1;min-width:0}
.wi-stem{font-size:27rpx;font-weight:600;color:var(--ink);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.wi-meta{display:flex;align-items:center;gap:8rpx;font-size:22rpx;color:var(--muted);margin-top:10rpx;flex-wrap:wrap}
.et-dot{width:12rpx;height:12rpx;border-radius:50%;flex-shrink:0}
.wi-meta .dots{display:inline-flex;gap:6rpx;margin-left:6rpx}
.wi-meta .dot{width:14rpx;height:14rpx;border-radius:50%;background:#e3e5f0}
.wi-meta .dot.done{background:var(--brand)}
.pill{flex-shrink:0;font-size:21rpx;font-weight:700;border-radius:999rpx;padding:6rpx 18rpx;margin-top:4rpx}
.pill.due{background:#fff3de;color:#c78310}
.pill.done{background:#e4faf4;color:#12987f}
.pill.todo{background:#f0f1f6;color:#8a90a8}

/* 详情底部弹层 */
.mask{position:fixed;left:0;right:0;top:0;bottom:0;background:rgba(20,22,40,.45);z-index:50;display:flex;align-items:flex-end}
.dialog{background:#fff;width:100%;border-radius:24rpx 24rpx 0 0;padding:30rpx 30rpx 26rpx;box-sizing:border-box;max-height:86vh;overflow-y:auto}
.dlg-h{display:flex;align-items:center;justify-content:space-between;margin-bottom:14rpx}
.dlg-t{font-size:31rpx;font-weight:800;color:var(--ink)}
.dlg-x{font-size:28rpx;color:var(--muted);padding:6rpx 10rpx}
.d-sub{font-size:23rpx;color:var(--muted)}
.d-orig{color:#b7bbcf}
.d-stem{font-size:30rpx;font-weight:700;color:var(--ink);line-height:1.6;margin-top:14rpx}
.d-opts{margin-top:14rpx;font-size:26rpx;color:var(--ink);line-height:1.9}
.d-points{background:var(--soft);border-radius:16rpx;padding:18rpx 20rpx;font-size:24rpx;color:#4a4f6e;line-height:1.6;margin-top:16rpx}
.d-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:16rpx}
.ktag{font-size:22rpx;background:#eef0ff;color:var(--brand);border-radius:999rpx;padding:6rpx 18rpx;font-weight:600}
.d-errtype{margin-top:22rpx}
.d-errtype-t{font-size:24rpx;color:var(--muted);margin-bottom:12rpx}
.d-errtype-chips{display:flex;flex-wrap:wrap;gap:12rpx}
.etchip{font-size:24rpx;font-weight:600;color:var(--ink);background:#eceef6;border-radius:999rpx;padding:12rpx 26rpx}
.etchip.on{background:var(--brand);color:#fff}
.d-analysis{background:#fffaf0;border:2rpx solid #ffe3ae;border-radius:16rpx;padding:20rpx;margin-top:22rpx}
.d-analysis-t{font-size:25rpx;font-weight:800;color:#c78310;margin-bottom:8rpx}
.d-analysis-c{font-size:26rpx;color:var(--ink);line-height:1.7}
.d-analysis-hidden{margin-top:22rpx;text-align:center;font-size:25rpx;font-weight:600;color:var(--brand);background:#eef0ff;border-radius:16rpx;padding:22rpx 0}
.d-stat{font-size:23rpx;color:var(--muted);margin-top:20rpx;text-align:center}
.dlg-btn{margin-top:22rpx}

/* 扁平图标 */
.wi-ic .ic-img{width:38rpx;height:38rpx}

/* 快速复习入口 */
.review-entry{display:flex;align-items:center;gap:20rpx;background:linear-gradient(90deg,#5b6cf6,#8a5cf6);border-radius:32rpx;padding:28rpx 30rpx;margin-bottom:24rpx;box-shadow:0 12rpx 30rpx rgba(91,108,246,.28)}
.re-main{flex:1;min-width:0}
.re-t{font-size:31rpx;font-weight:800;color:#fff}
.re-s{font-size:23rpx;color:rgba(255,255,255,.82);margin-top:6rpx}
.re-go{font-size:27rpx;font-weight:700;color:#fff;background:rgba(255,255,255,.2);border-radius:999rpx;padding:12rpx 24rpx;flex-shrink:0}
