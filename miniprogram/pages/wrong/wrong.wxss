/* 纵向筛选面板：每个维度一行、选项平铺 */
.filter-panel{background:#fff;border-radius:24rpx;padding:8rpx 24rpx 12rpx;margin:8rpx 0 16rpx;box-shadow:0 8rpx 30rpx rgba(40,45,90,.06)}
.frow{display:flex;align-items:flex-start;gap:18rpx;padding:18rpx 0;border-bottom:2rpx solid #f0f1f6}
.frow:last-child{border-bottom:none}
.frow-lb{flex-shrink:0;width:76rpx;font-size:25rpx;font-weight:700;color:#3a4060;line-height:48rpx}
.chips{display:flex;flex-wrap:wrap;gap:12rpx;flex:1;min-width:0}
.chip{padding:10rpx 22rpx;border-radius:18rpx;background:#f0f2f8;color:#6a7192;font-size:23rpx;line-height:28rpx;white-space:nowrap}
.chip.on{background:linear-gradient(90deg,var(--brand),var(--brand2));color:#fff;font-weight:700}
.filter-reset{font-size:23rpx;color:#5b6cf6;text-align:right;margin:-6rpx 4rpx 14rpx}
.card.list{padding:16rpx}
.wrong-item{background:#fff;border-radius:24rpx;padding:26rpx;margin-bottom:20rpx;border:2rpx solid var(--line)}
.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:14rpx}
.subject-line{font-size:21rpx;color:#8b93b3;margin-bottom:8rpx}
.stem{font-size:26rpx;line-height:1.5;color:#3b4160}
.meta{display:flex;justify-content:space-between;align-items:center;margin-top:20rpx;font-size:22rpx;color:var(--muted)}
.dots{display:flex;gap:8rpx;align-items:center}
.dot{width:16rpx;height:16rpx;border-radius:50%;background:var(--line);display:inline-block}
.dot.done{background:var(--mint)}
.detail-hint{font-size:21rpx;color:#5b6cf6;text-align:right;margin-top:12rpx}
/* 详情解析弹窗 */
.mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(20,24,45,.5);z-index:100;display:flex;align-items:center;justify-content:center;padding:32rpx}
.dialog{background:#fff;border-radius:28rpx;width:100%;max-height:86vh;overflow-y:auto;padding:32rpx}
.dlg-h{font-size:32rpx;font-weight:800;display:flex;justify-content:space-between;align-items:center;margin-bottom:20rpx;position:sticky;top:0;background:#fff;z-index:2;padding-bottom:12rpx}
.dlg-x{font-size:32rpx;color:var(--muted);padding:0 10rpx}
.d-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-bottom:16rpx}
.d-tags.kp{margin-top:16rpx}
.d-tags .qt{background:#fff0e6;color:#e08a3c}
.d-tags .origin{background:#eef4ff;color:#4a72c4}
.d-stem{font-size:28rpx;line-height:1.6;color:#2b3050;font-weight:600;margin-bottom:16rpx}
.d-opts{font-size:25rpx;color:#4a5170;line-height:1.9;background:#f7f8fd;border-radius:14rpx;padding:16rpx 20rpx}
.d-answer{font-size:26rpx;line-height:1.6;margin-top:16rpx;color:#3b4160}
.d-answer .ans{color:#12987f;font-weight:700}
.d-line{font-size:24rpx;line-height:1.6;color:#5a6180;margin-top:8rpx}
.d-analysis{background:#f0f7ff;border-radius:16rpx;padding:20rpx;margin-top:20rpx}
.d-analysis-t{font-size:26rpx;font-weight:800;color:#3a72c4;margin-bottom:10rpx}
.d-analysis-c{font-size:25rpx;line-height:1.7;color:#2b3a55;word-break:break-all}
.d-stat{font-size:22rpx;color:#8b93b3;margin-top:16rpx;text-align:center}
