/* 试卷页 · 现代风 v2：科目常驻横滑 + 次级筛选弹层；列表行瘦身；导入合并为列表卡 */
.sec-row{display:flex;align-items:baseline;justify-content:space-between;margin:2rpx 0 18rpx}
.sec-t2{font-size:31rpx;font-weight:800;color:var(--ink)}
.imp-t{margin-top:40rpx}

/* 科目栏 + 筛选按钮 */
.rail-row{display:flex;align-items:center;gap:16rpx;margin-bottom:18rpx}
.rail{flex:1;white-space:nowrap}
.chip{display:inline-block;padding:13rpx 28rpx;border-radius:999rpx;background:#eceef6;color:var(--ink);font-size:25rpx;font-weight:600;margin-right:12rpx}
.chip.on{background:var(--brand);color:#fff}
.filter-btn{position:relative;flex-shrink:0;font-size:25rpx;font-weight:700;color:var(--ink);background:#fff;border-radius:999rpx;padding:13rpx 28rpx;box-shadow:0 6rpx 20rpx rgba(40,45,90,.08)}
.fbadge{position:absolute;top:-10rpx;right:-6rpx;background:#ff5c6c;color:#fff;font-size:19rpx;font-weight:700;min-width:32rpx;height:32rpx;line-height:32rpx;border-radius:999rpx;text-align:center;padding:0 6rpx;box-sizing:border-box}

/* 已选次级筛选标签 */
.tags-row{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:18rpx}
.atag{font-size:23rpx;color:var(--brand);background:#eef0ff;border-radius:999rpx;padding:9rpx 20rpx;font-weight:600}
.atag .ax{margin-left:10rpx;color:#9aa0c3}

/* 试卷列表卡 */
.list-card{background:#fff;border-radius:28rpx;box-shadow:0 10rpx 30rpx rgba(40,45,90,.06);padding:6rpx 28rpx}
.paper{display:flex;gap:20rpx;align-items:center;padding:24rpx 0;border-bottom:2rpx solid var(--line)}
.paper:last-child{border-bottom:none}
.paper .thumb{width:80rpx;height:80rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;font-size:38rpx;flex-shrink:0}
.paper .info{flex:1;min-width:0}
.paper .info .b{font-size:27rpx;font-weight:700;color:var(--ink);line-height:1.45;word-break:break-all}
.paper .info .sp{font-size:23rpx;color:var(--muted);margin-top:5rpx}
.st-row{display:flex;align-items:center;gap:14rpx;margin-top:10rpx}
.cap{font-size:21rpx;font-weight:700;border-radius:999rpx;padding:4rpx 16rpx}
.cap.none{background:#f0f1f6;color:#8a90a8}
.cap.part{background:#e6ebff;color:#4a55c8}
.cap.done{background:#e4faf4;color:#12987f}
.scope-t{font-size:21rpx;color:#a6abc0}
.side-ops{flex-shrink:0}
.paper-empty{text-align:center;color:var(--muted);font-size:25rpx;padding:52rpx 0}
.pe-ic{font-size:56rpx;margin-bottom:14rpx}
.pe-btn{display:inline-block;margin-top:20rpx;font-size:25rpx;font-weight:700;color:var(--brand);background:#eef0ff;border-radius:999rpx;padding:12rpx 34rpx}

/* 导入列表卡 */
.import-card{background:#fff;border-radius:28rpx;box-shadow:0 10rpx 30rpx rgba(40,45,90,.06);padding:6rpx 28rpx}
.irow{display:flex;align-items:center;gap:20rpx;padding:24rpx 0;border-bottom:2rpx solid var(--line)}
.irow:last-child{border-bottom:none}
.iic{width:72rpx;height:72rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;font-size:34rpx;flex-shrink:0}
.irow .it{flex:1;font-size:28rpx;font-weight:700;color:var(--ink)}
.ibadge{font-size:20rpx;font-weight:700;color:#4a55c8;background:#e6ebff;border-radius:999rpx;padding:4rpx 16rpx}
.ibadge.blue{color:#12987f;background:#e4faf4}
.irow .arr{color:var(--muted);font-size:34rpx}
.steps{text-align:center;font-size:23rpx;color:var(--muted);margin-top:20rpx}
.steps .sarr{margin:0 10rpx;color:#c3c7da}

/* 筛选弹层 */
.mask{position:fixed;left:0;right:0;top:0;bottom:0;background:rgba(20,22,40,.45);z-index:50;display:flex;align-items:flex-end}
.sheet{background:#fff;width:100%;border-radius:24rpx 24rpx 0 0;padding:32rpx 30rpx 26rpx;box-sizing:border-box;max-height:86vh;overflow-y:auto}
.sheet-t{font-size:32rpx;font-weight:800;color:var(--ink);margin-bottom:8rpx}
.fgroup{padding:18rpx 0 4rpx;border-bottom:2rpx solid var(--line)}
.fgroup .flb{display:block;font-size:25rpx;font-weight:700;color:var(--ink);margin-bottom:14rpx}
.fgroup .chips{display:flex;flex-wrap:wrap}
.fgroup .chip{margin-bottom:14rpx}
.sheet-btns{display:flex;gap:18rpx;margin-top:26rpx}
.sbtn{flex:1;text-align:center;font-size:29rpx;font-weight:700;border-radius:999rpx;padding:22rpx 0}
.sbtn.ghost{background:#eef0ff;color:var(--brand)}
.sbtn.primary{background:linear-gradient(90deg,var(--brand),var(--brand2));color:#fff}

/* 扁平图标 */
.thumb .ic-img{width:40rpx;height:40rpx}
.side-ops{display:flex;flex-direction:column;align-items:center;gap:10rpx}
.edit-link{font-size:23rpx;color:#4353d6;background:#eef0fe;border-radius:999rpx;padding:6rpx 20rpx}
.meta-inp{background:#f5f6fb;border:1rpx solid #e6e8f2;border-radius:14rpx;padding:16rpx 18rpx;font-size:26rpx;width:100%;box-sizing:border-box;color:#2b3050}
.meta-2col{display:flex;gap:20rpx}
.meta-col{flex:1}
