.upload{background:linear-gradient(135deg,#eef0ff,#f6f0ff);border:4rpx dashed #c3c9ff;border-radius:32rpx;padding:40rpx;text-align:center;margin-bottom:28rpx}
.upload .ic{font-size:76rpx}
.upload .b{font-size:30rpx;font-weight:700;margin:12rpx 0 6rpx}
.upload .sp{font-size:22rpx;color:var(--muted)}
.paper{display:flex;gap:20rpx;align-items:center;padding:22rpx 0;border-bottom:2rpx solid var(--line)}
.paper:last-child{border:none}
.paper .thumb{width:88rpx;height:108rpx;border-radius:14rpx;background:linear-gradient(135deg,#dfe4ff,#efe6ff);display:flex;align-items:center;justify-content:center;font-size:40rpx;flex-shrink:0}
.paper .info{flex:1;min-width:0}
.paper .info .b{font-size:26rpx;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.paper .info .sp{font-size:22rpx;color:var(--muted);margin-top:6rpx}
.paper .info .sp .meta{color:#5b6cf6}
.paper .info .meta-full{font-size:20rpx;color:#7c83a4;margin-top:6rpx;line-height:1.5;word-break:break-all}
.paper-tags{flex-shrink:0;display:flex;flex-direction:column;align-items:flex-end;gap:8rpx}
.tag.brushed{background:#e4faf4;color:#12987f}
.tag.unbrushed{background:#f0f1f6;color:#98a0b8}
.tag.scope.sys{background:#eef0ff;color:#5b6cf6}
.tag.scope.usr{background:#f0f1f6;color:#7c83a4}
/* 筛选栏 */
.filters{display:flex;gap:12rpx;margin:8rpx 0 16rpx}
.filters picker{flex:1;min-width:0}
.fitem{display:flex;align-items:center;justify-content:space-between;gap:6rpx;background:#f5f6fb;border:2rpx solid #e6e8f2;border-radius:14rpx;padding:14rpx 16rpx;font-size:23rpx;color:#3a4060}
.fval{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.farrow{color:#9aa2bf;font-size:20rpx;flex-shrink:0}
.filter-reset{font-size:23rpx;color:#5b6cf6;text-align:right;margin:-6rpx 4rpx 14rpx}
.paper .sw-box{flex-shrink:0;display:flex;align-items:center}
.paper .sw-box switch{transform:scale(.8);transform-origin:right center}
.paper-empty{font-size:24rpx;color:#98a0b8;text-align:center;padding:40rpx 0;line-height:1.6}
/* 我的试卷置顶 + 导入方式分组 */
.mine-t{margin-top:8rpx}
.mine-hint{margin:14rpx 4rpx 30rpx}
.import-title{font-size:26rpx;font-weight:800;color:#5a6180;margin:8rpx 4rpx 20rpx;padding-top:24rpx;border-top:2rpx solid var(--line)}
/* 三种导入方式卡片 */
.way{display:flex;gap:22rpx;align-items:flex-start;background:#fff;border:2rpx solid var(--line);border-radius:24rpx;padding:26rpx;margin-bottom:18rpx}
.way-excel{background:linear-gradient(135deg,#f0fbf6,#f4f7ff);border-color:#bfe8d5}
.way-ic{font-size:56rpx;line-height:1;flex-shrink:0;width:76rpx;text-align:center}
.way-body{flex:1;min-width:0}
.way-t{font-size:28rpx;font-weight:800;display:flex;align-items:center;gap:10rpx}
.way-badge{font-size:18rpx;font-weight:700;color:#fff;background:linear-gradient(135deg,#7c6cf6,#9b6cf6);padding:3rpx 12rpx;border-radius:20rpx}
.way-badge.blue{background:linear-gradient(135deg,#2bb39a,#2b8fb3)}
.way-s{font-size:22rpx;color:var(--muted);line-height:1.5;margin:8rpx 0 16rpx}
.way-btns{display:flex;gap:14rpx;flex-wrap:wrap}
.tip-card{background:#fffaf0;border:2rpx solid #f5e2b8;border-radius:22rpx;padding:24rpx;margin-bottom:28rpx}
.tip-t{font-size:26rpx;font-weight:800;margin-bottom:12rpx;color:#a8762a}
.tip-l{font-size:23rpx;color:#8a6a35;line-height:1.9}
