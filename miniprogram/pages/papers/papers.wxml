<view class="wrap">
  <view class="hdr"><view class="hi">试卷中心<text class="small">把你的试卷变成专属题库</text></view></view>

  <view class="upload">
    <view class="ic">📤</view>
    <view class="b">上传试卷，开始识别</view>
    <view class="sp">拍照/选图识别更准 · 也支持 PDF · 单卷≤10页</view>
    <button class="btn mini" style="margin-top:24rpx" bindtap="chooseImage">📷 拍照 / 选图识别</button>
    <button class="btn ghost mini" style="margin-top:12rpx" bindtap="chooseFile">📄 选择 PDF 文件</button>
    <view class="hint" style="margin-top:12rpx">需云端开启 AI 生文模型；未开启时自动用示例题体验 ↓</view>
    <button class="btn ghost mini" style="margin-top:10rpx" bindtap="loadSample">⚡ 载入示例试卷（体验识别）</button>
  </view>

  <view class="sec-t">我的试卷 <text class="tag g">已入库 {{confirmedCount}}</text></view>
  <view class="card">
    <view wx:for="{{papers}}" wx:key="id" class="paper" bindtap="onPaper" data-id="{{item.id}}" data-status="{{item.status}}">
      <view class="thumb">📐</view>
      <view class="info"><view class="b">{{item.title}}</view><view class="sp">{{item.subject}} · {{item.grade}} · {{item.count}}题</view></view>
      <text class="tag {{item.statusClass}}">{{item.statusLabel}}</text>
    </view>
  </view>
  <view class="hint">识别后进入「校对」页，确认的题目才进入题库参与组卷</view>
</view>