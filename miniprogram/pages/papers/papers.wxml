<view class="wrap">
  <view class="hdr"><view class="hi">试卷中心<text class="small">三种方式把试卷变成专属题库</text></view></view>

  <!-- 我的试卷（置顶）：按「来源+学科」合并列举 + 四维度筛选 -->
  <view class="sec-t mine-t">我的试卷 <text class="tag g">已启用 {{enabledCount}}/{{sources.length}}</text></view>

  <!-- 筛选项：科目 / 省市 / 年级 / 是否已刷 -->
  <view class="filters">
    <picker mode="selector" range="{{subjectOptions}}" bindchange="onFilterSubject">
      <view class="fitem"><text class="fval">{{filterSubject || '全部科目'}}</text><text class="farrow">▾</text></view>
    </picker>
    <picker mode="selector" range="{{regionOptions}}" bindchange="onFilterRegion">
      <view class="fitem"><text class="fval">{{filterRegion || '全部省市'}}</text><text class="farrow">▾</text></view>
    </picker>
    <picker mode="selector" range="{{gradeOptions}}" bindchange="onFilterGrade">
      <view class="fitem"><text class="fval">{{filterGrade || '全部年级'}}</text><text class="farrow">▾</text></view>
    </picker>
    <picker mode="selector" range="{{brushedOptions}}" range-key="label" bindchange="onFilterBrushed">
      <view class="fitem"><text class="fval">{{filterBrushed==='yes'?'已刷':(filterBrushed==='no'?'未刷':'刷题状态')}}</text><text class="farrow">▾</text></view>
    </picker>
  </view>
  <view wx:if="{{filterSubject||filterRegion||filterGrade||filterBrushed}}" class="filter-reset" bindtap="resetFilter">✕ 清除筛选，显示全部</view>

  <view class="card">
    <view wx:if="{{loadingSources}}" class="paper-empty">加载中…</view>
    <view wx:elif="{{!sources.length}}" class="paper-empty">没有符合条件的试卷<br/>试试清除筛选，或导入并确认新试卷</view>
    <view wx:for="{{sources}}" wx:key="key" class="paper" bindtap="onSource" data-subject="{{item.subject}}" data-original="{{item.original}}">
      <view class="thumb">📐</view>
      <view class="info">
        <view class="b">{{item.original}}</view>
        <view class="sp">{{item.subject}} · {{item.count}}题<text wx:if="{{item.metaText}}" class="meta"> · {{item.metaText}}</text></view>
      </view>
      <view class="paper-tags">
        <text wx:if="{{item.brushed}}" class="tag brushed">已刷</text>
        <text wx:else class="tag unbrushed">未刷</text>
      </view>
      <view class="sw-box" catchtap="noop">
        <switch checked="{{item.enabled}}" color="#5b6cf6" bindchange="onToggle" data-subject="{{item.subject}}" data-original="{{item.original}}" />
      </view>
    </view>
  </view>
  <view class="hint mine-hint">按「来源 + 学科」合并显示；关闭开关后该组题目不再进入每日打卡。首次进入已按你的年级学段自动勾选，点试卷可查看/修改题目。</view>

  <view class="import-title">导入新试卷</view>
  <!-- 方式一：拍照识别 -->
  <view class="way">
    <view class="way-ic">📷</view>
    <view class="way-body">
      <view class="way-t">拍照 / 选图识别 <text class="way-badge">AI</text></view>
      <view class="way-s">摄像头或相册选试卷照片，视觉模型自动拆题打标签</view>
      <button class="btn mini" bindtap="chooseImage">去拍照 / 选图</button>
    </view>
  </view>

  <!-- 方式二：PDF 识别 -->
  <view class="way">
    <view class="way-ic">📄</view>
    <view class="way-body">
      <view class="way-t">导入 PDF 识别 <text class="way-badge">AI</text></view>
      <view class="way-s">从微信聊天选 PDF 试卷，AI 识别后自动拆题</view>
      <button class="btn ghost mini" bindtap="chooseFile">选择 PDF 文件</button>
    </view>
  </view>

  <!-- 方式三：Excel 批量导入 -->
  <view class="way way-excel">
    <view class="way-ic">📊</view>
    <view class="way-body">
      <view class="way-t">Excel 批量导入 <text class="way-badge blue">批量</text></view>
      <view class="way-s">不用 AI，按样例填好 Excel 一次导入；逐题确认修改后一键入库</view>
      <view class="way-btns">
        <button class="btn ghost mini" bindtap="downloadSample">📥 下载样例</button>
        <button class="btn mini" bindtap="chooseExcel" disabled="{{importing}}">{{importing ? '解析中…' : '📊 选择 Excel'}}</button>
      </view>
    </view>
  </view>

  <view class="tip-card">
    <view class="tip-t">导入后做什么？</view>
    <view class="tip-l">1. 三种方式导入后都会进入「校对」页</view>
    <view class="tip-l">2. 逐题确认或点「修改」纠正（支持全题型）</view>
    <view class="tip-l">3. 点「确认全部并入库」，题目才进入题库参与组卷</view>
  </view>
</view>
