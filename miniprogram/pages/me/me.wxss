/* 我的页 · 现代风 v2：身份卡 + 按意思分组的菜单 + 图标色块 */
.id-card{display:flex;align-items:center;gap:24rpx;background:#fff;border-radius:28rpx;box-shadow:0 10rpx 30rpx rgba(40,45,90,.06);padding:28rpx;margin-bottom:24rpx}
.id-card .av{width:96rpx;height:96rpx;border-radius:28rpx;background:linear-gradient(135deg,var(--brand),var(--brand2));display:flex;align-items:center;justify-content:center;font-size:48rpx;color:#fff;flex-shrink:0;overflow:hidden}
.id-txt{flex:1;min-width:0}
.id-name{font-size:32rpx;font-weight:800;color:var(--ink)}
.id-name .edit-ic{font-size:25rpx;color:var(--brand);font-weight:500}
.id-sub{font-size:23rpx;color:var(--muted);margin-top:5rpx}
.setup-bar{display:flex;align-items:center;gap:10rpx;background:linear-gradient(135deg,#fff6e8,#fff0f3);border:2rpx solid #f5dfb8;border-radius:20rpx;padding:20rpx 24rpx;margin-bottom:24rpx;font-size:25rpx;color:#a8762a}
.setup-bar .ar{margin-left:auto;font-size:34rpx;color:#d8a850}
.grp-t{font-size:24rpx;color:var(--muted);margin:6rpx 0 12rpx 6rpx}
.menu{background:#fff;border-radius:28rpx;box-shadow:0 10rpx 30rpx rgba(40,45,90,.06);overflow:hidden;margin-bottom:26rpx;padding:0 28rpx}
.mi{display:flex;align-items:center;gap:20rpx;padding:22rpx 0;border-bottom:2rpx solid var(--line)}
.mi:last-child{border-bottom:none}
.mi-ic{width:72rpx;height:72rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;font-size:32rpx;flex-shrink:0}
.mi-tx{font-size:28rpx;color:var(--ink)}
.mi .ar{margin-left:auto;color:#c3c9d8;font-size:36rpx}

/* 扁平图标 */
.mi-ic .ic-img{width:38rpx;height:38rpx}
