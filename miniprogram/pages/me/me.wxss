.me-hd{display:flex;align-items:center;gap:26rpx;padding:16rpx 0 36rpx}
.me-hd .av{width:112rpx;height:112rpx;border-radius:50%;background:linear-gradient(135deg,var(--brand),var(--brand2));display:flex;align-items:center;justify-content:center;font-size:56rpx;color:#fff}
.me-hd .b{font-size:36rpx;font-weight:800}
.me-hd .sp{font-size:24rpx;color:var(--muted);margin-top:6rpx}
.card.demo{padding:28rpx}
.menu{background:#fff;border-radius:28rpx;overflow:hidden;margin-bottom:24rpx}
.mi{display:flex;align-items:center;gap:24rpx;padding:28rpx 32rpx;border-bottom:2rpx solid var(--line);font-size:28rpx}
.mi:last-child{border:none}
.mi .ic{font-size:36rpx}
.mi .ar{margin-left:auto;color:#c3c9d8;font-size:36rpx}
.cloud-res{margin-top:20rpx;background:#f7f8fc;border-radius:18rpx;padding:12rpx 18rpx}
.cloud-row{display:flex;align-items:center;gap:14rpx;padding:10rpx 0;font-size:25rpx;border-bottom:2rpx solid #eef0f6}
.cloud-row:last-child{border:none}
.cloud-row .dot{width:34rpx;height:34rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:22rpx;flex-shrink:0}
.cloud-row.ok .dot{background:#22b573}
.cloud-row.no .dot{background:#f0635b}
.cloud-row .cname{font-weight:700;min-width:150rpx}
.cloud-row .cmsg{color:var(--muted);flex:1}/* 用户资料 */
.me-hd .av-img{overflow:hidden;border:none}
.me-hd-txt{flex:1;min-width:0}
.me-hd .edit-ic{font-size:26rpx;color:var(--brand);font-weight:500}
.setup-bar{display:flex;align-items:center;gap:10rpx;background:linear-gradient(135deg,#fff6e8,#fff0f3);border:2rpx solid #f5dfb8;border-radius:20rpx;padding:20rpx 24rpx;margin:-16rpx 0 24rpx;font-size:25rpx;color:#a8762a}
.setup-bar .ar{margin-left:auto;font-size:34rpx;color:#d8a850}
