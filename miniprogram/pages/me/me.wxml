<view class="wrap">
  <view class="me-hd" bindtap="goProfile">
    <image wx:if="{{avatar}}" class="av av-img" src="{{avatar}}" mode="aspectFill"></image>
    <view wx:else class="av">🧑‍🎓</view>
    <view class="me-hd-txt">
      <view class="b">{{nickname || '点击设置昵称'}} <text class="edit-ic">✎</text></view>
      <view class="sp">{{gradeLabel || '未设置年级'}} · 人教版 · Lv.{{level}}</view>
    </view>
  </view>
  <view wx:if="{{needSetup}}" class="setup-bar" bindtap="goProfile">
    <text>👋 首次使用，点此设置你的头像和昵称</text><text class="ar">›</text>
  </view>
  <view class="menu">
    <view class="mi" bindtap="goParent"><text class="ic">👨‍👩‍👧</text>家长绑定与周报订阅<text class="ar">›</text></view>
    <view class="mi" bindtap="goSubjects"><text class="ic">⚙️</text>学习设置<text class="ar">›</text></view>
    <view class="mi" bindtap="goEnergy"><text class="ic">⚡</text>能量明细 / 补签卡<text class="ar">›</text></view>
    <view class="mi" bindtap="goPoints"><text class="ic">💎</text>积分规则与晋级路线<text class="ar">›</text></view>
  </view>
  <view class="menu">
    <view class="mi" bindtap="goPrivacy"><text class="ic">🔒</text>隐私与未成年人保护<text class="ar">›</text></view>
    <view class="mi" bindtap="goConsole"><text class="ic">🛡️</text>管理端（需管理员登录）<text class="ar">›</text></view>
  </view>
  <view class="hint">本产品为学习工具，不含付费学科培训</view>
</view>
