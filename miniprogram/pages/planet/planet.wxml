<view class="page">
  <!-- 场景即页头：等级信息只在这里出现一次，右上胶囊进账本 -->
  <view class="scene" bindtap="goSceneDetail">
    <image class="scene-img" src="{{sceneImg}}" mode="aspectFill" binderror="onSceneError" />
    <view class="scene-shade"></view>
    <view class="scene-decors">
      <text class="sd" wx:for="{{sceneDecors}}" wx:key="id">{{item.emoji}}</text>
    </view>
    <view class="bal-pill" catchtap="goPoints">⚡ {{energy}}</view>
    <view class="scene-cap2" wx:if="{{lv}}">
      <view class="sc-name">Lv.{{lv.level}} {{lv.name}}</view>
      <view class="sc-sub">{{lv.title}} · {{lv.region}}<text wx:if="{{baseStage}}"> · {{baseStage.name}}</text></view>
    </view>
    <view class="scene-detail2">星球档案 ›</view>
  </view>

  <!-- 成长：进度 + 差距 + 介绍 + 基地建设 -->
  <view class="card" wx:if="{{lv}}">
    <view class="g-top">累计 ⚡{{totalEarned}} · 本级进度 {{lv.pct}}%</view>
    <view class="bar"><view class="bar-in gold" style="width: {{lv.pct}}%"></view></view>
    <view class="g-next" wx:if="{{!lv.isMax}}">距 Lv.{{lv.nextLevel}} {{lv.nextName}} 还差 {{lv.toNext}} 星能量</view>
    <view class="g-next" wx:else>已抵达当前宇宙的边界，探索永无止境 ✨</view>
    <view class="g-desc">{{lv.desc}}</view>
    <view class="base-box" wx:if="{{baseStage}}">
      <view class="base-head">
        <text class="base-title">🏗️ 基地建设 · {{baseStage.name}}</text>
        <text class="base-num">成长 {{planet.growth}}</text>
      </view>
      <view class="bar"><view class="bar-in" style="width: {{basePct}}%"></view></view>
      <view class="g-next">{{baseNextText}}</view>
    </view>
  </view>

  <!-- 宇宙探索地图：节点横幅入口 -->
  <view class="card map-card" bindtap="goAtlas">
    <view class="map-nodes">
      <image wx:for="{{mapNodes}}" wx:key="level" class="mn-img {{item.unlocked ? '' : 'locked'}}" src="{{item.node}}" mode="aspectFill"></image>
    </view>
    <view class="map-main">
      <view class="map-t">宇宙探索地图</view>
      <view class="map-s">已解锁 {{unlockedCount}}/12<text wx:if="{{lv && !lv.isMax}}"> · 下一站 {{lv.nextName}}</text></view>
    </view>
    <text class="map-arr">›</text>
  </view>

  <view class="hist-link" bindtap="toggleHistory">
    <text>📜 成长记录</text>
    <text class="hl-arr">{{showHistory ? '收起' : '展开'}} ›</text>
  </view>
  <view class="card hist-card" wx:if="{{showHistory}}">
    <view wx:if="{{levelHistory.length}}">
      <view class="hist-row" wx:for="{{levelHistory}}" wx:key="index">
        <text class="hist-lv">Lv.{{item.level}} {{item.name}}</text>
        <text class="hist-at">{{item.atText}}</text>
      </view>
    </view>
    <view class="hist-empty" wx:else>暂无升级记录，继续学习积累星能量吧</view>
  </view>

  <!-- 星际商城 -->
  <view class="card">
    <view class="sec-title">🛒 星际商城 <text class="sec-tip">余额 ⚡{{energy}}</text></view>
    <view class="tabs">
      <view class="tab {{shopTab === 'supply' ? 'on' : ''}}" data-tab="supply" bindtap="onShopTab">能量补给</view>
      <view class="tab {{shopTab === 'decor' ? 'on' : ''}}" data-tab="decor" bindtap="onShopTab">星球装扮</view>
    </view>
    <view wx:if="{{shopTab === 'supply'}}" class="shop-hint">补给用于提升基地成长，成长满格后基地升级。</view>
    <view class="item" wx:for="{{shopItems}}" wx:key="id">
      <image wx:if="{{item.img}}" class="it-img" src="{{item.img}}" mode="aspectFill"></image>
      <text wx:else class="it-emoji">{{item.emoji}}</text>
      <view class="it-main">
        <text class="it-name">{{item.name}}</text>
        <text class="it-desc">{{item.desc}}<text wx:if="{{item.planetName}}"> · {{item.planetName}} 专属</text></text>
        <text wx:if="{{item.growth}}" class="it-growth">基地成长 +{{item.growth}}</text>
      </view>
      <view class="it-btn {{item.owned ? 'owned' : ''}} {{item.locked ? 'locked' : ''}}" data-id="{{item.id}}" data-owned="{{item.owned ? 1 : 0}}" bindtap="onBuy">{{item.btn}}</view>
    </view>
  </view>

  <view class="foot">探索宇宙，始于知识</view>
</view>
