<view class="wrap">
  <view class="hdr">
    <view class="hi">我的农场<text class="small">每一门科目，都有一只陪你成长的小伙伴</text></view>
    <view class="energy-pill">⚡ {{energy}} 能量</view>
  </view>

  <!-- 科目农场切换 -->
  <scroll-view class="subj-tabs" scroll-x>
    <view wx:for="{{subjects}}" wx:key="subject" class="subj-tab {{index === subjectIndex ? 'on' : ''}}" data-i="{{index}}" bindtap="onSwitchSubject">
      <text class="st-emoji">{{item.animalEmoji}}</text>
      <text class="st-name">{{item.subject}}</text>
    </view>
  </scroll-view>

  <!-- 当前农场场景：写实背景图 + 分层装饰（v1.9.30） -->
  <view class="farm-scene">
    <view class="scene-viewport">
      <!-- 写实农场背景：蓝天/远山/草地 -->
      <image class="scene-bg" src="/images/decor/farm-bg.jpg" mode="aspectFill"></image>
      <view class="sun">☀️</view>
      <!-- 彩虹挂在天上 -->
      <image wx:if="{{hasRainbow}}" class="decor-img rainbow" src="/images/decor/rainbow.webp" mode="aspectFit"></image>
      <!-- 远景：大树 / 木屋，明显大于宠物 -->
      <image wx:if="{{hasTree}}" class="decor-img tree" src="/images/decor/tree.webp" mode="aspectFit"></image>
      <image wx:if="{{hasHouse}}" class="decor-img house" src="/images/decor/house.webp" mode="aspectFit"></image>
      <!-- 中景：一排篱笆横贯草地 -->
      <image wx:if="{{hasFence}}" class="decor-img fence" src="/images/decor/fence.webp" mode="scaleToFill"></image>
      <!-- 宠物：自己跑来跑去，偶尔停下；点击互动 -->
      <view class="pet-lane {{current && current.animalOwned ? 'roaming' : 'locked'}}" bindtap="onPetTap" style="animation-delay:{{roamDelay}}s">
        <view class="pet-move">
          <view class="pet-scale {{petBouncing ? 'bouncing' : ''}}">
            <text wx:if="{{crown}}" class="pet-crown" style="{{spriteFrames > 0 ? 'top:-' + (petW * 0.34) + 'rpx;font-size:' + (petW * 0.52) + 'rpx' : ''}}">👑</text>
            <view wx:if="{{spriteFrames > 0}}" class="pet3d" style="width:{{petW}}rpx;height:{{petW * spriteRatio}}rpx">
              <image class="pet3d-img" src="{{animalImg}}" mode="scaleToFill" style="width:{{petW * spriteFrames}}rpx;height:{{petW * spriteRatio}}rpx;animation-delay:{{roamDelay}}s"></image>
            </view>
            <image wx:elif="{{animalImg}}" class="pet-img" src="{{animalImg}}" mode="aspectFit" style="width:{{imgSize}}rpx;height:{{imgSize}}rpx"></image>
            <text wx:else class="pet-face" style="font-size:{{petSize}}rpx">{{current.animalEmoji}}</text>
          </view>
          <view class="pet-shadow {{animalImg ? 'img-shadow' : ''}}" style="{{animalImg ? 'width:' + (petW * 1.15) + 'rpx' : ''}}"></view>
        </view>
        <view wx:if="{{petBubble}}" class="pet-bubble">{{petBubble}}</view>
        <view wx:if="{{!current || !current.animalOwned}}" class="animal-lock">🔒 点我领养</view>
      </view>
      <!-- 近景：一丛丛鲜花栽在地上（遮挡宠物脚部形成景深） -->
      <image wx:if="{{hasFlower}}" class="decor-img flower f1" src="/images/decor/flowers.webp" mode="aspectFit"></image>
      <image wx:if="{{hasFlower}}" class="decor-img flower f2" src="/images/decor/flowers.webp" mode="aspectFit"></image>
      <image wx:if="{{hasFlower}}" class="decor-img flower f3" src="/images/decor/flowers.webp" mode="aspectFit"></image>
      <!-- 小草点缀 -->
      <view wx:if="{{hasGrass}}" class="grass g1">🌿</view>
      <view wx:if="{{hasGrass}}" class="grass g2">🌿</view>
      <view wx:if="{{hasGrass}}" class="grass g3">🌿</view>
    </view>
    <view class="farm-info">
      <view class="farm-title">
        <text class="fn">{{current.subject}}农场</text>
        <text class="pet">{{current.animalName}} · {{stageName}}</text>
      </view>
      <view class="growth-bar"><view class="growth-fill" style="width:{{growthPct}}%"></view></view>
      <view class="growth-meta"><text>成长值 {{current.growth}}</text><text>{{stageNext}}</text></view>
    </view>
  </view>

  <!-- 商店 -->
  <view class="sec-t">🛒 农场商店 <text class="tag y">用能量兑换</text></view>
  <view class="shop-tabs">
    <view class="shop-tab {{shopTab === 'animal' ? 'on' : ''}}" data-tab="animal" bindtap="onShopTab">🐾 小动物</view>
    <view class="shop-tab {{shopTab === 'food' ? 'on' : ''}}" data-tab="food" bindtap="onShopTab">🍃 食物</view>
    <view class="shop-tab {{shopTab === 'decor' ? 'on' : ''}}" data-tab="decor" bindtap="onShopTab">🏡 装饰</view>
  </view>

  <view class="card shop-card" wx:if="{{shopTab === 'animal'}}">
    <view class="shop-item">
      <view class="si-emoji">{{current.animalEmoji}}</view>
      <view class="si-body">
        <view class="si-name">{{current.animalKind}} · {{current.animalName}}</view>
        <view class="si-desc">{{current.animalDesc}}</view>
      </view>
      <button class="buy-btn {{current.animalOwned ? 'owned' : ''}}" disabled="{{current.animalOwned || buying}}" bindtap="onBuyAnimal">{{current.animalOwned ? '已领养' : '⚡' + animalPrice}}</button>
    </view>
    <view class="shop-tip">每个科目的农场都有一只专属小动物，领养后即可喂养成长。能量通过每日打卡获得。</view>
  </view>

  <view class="card shop-card" wx:if="{{shopTab === 'food'}}">
    <view class="shop-grid">
      <view class="food-item" wx:for="{{foods}}" wx:key="id">
        <view class="fi-emoji">{{item.emoji}}</view>
        <view class="fi-name">{{item.name}}</view>
        <view class="fi-desc">{{item.desc}}</view>
        <button class="buy-btn small" disabled="{{buying || !current.animalOwned}}" data-id="{{item.id}}" bindtap="onFeed">⚡{{item.price}}</button>
      </view>
    </view>
    <view class="shop-tip" wx:if="{{!current.animalOwned}}">先到「小动物」页领养{{current.subject}}农场的小伙伴，再来喂养吧～</view>
  </view>

  <view class="card shop-card" wx:if="{{shopTab === 'decor'}}">
    <view class="shop-grid">
      <view class="food-item" wx:for="{{decors}}" wx:key="id">
        <view class="fi-emoji">{{item.emoji}}</view>
        <view class="fi-name">{{item.name}}</view>
        <view class="fi-desc">{{item.desc}}</view>
        <button class="buy-btn small {{decorOwned[item.id] ? 'owned' : ''}}" disabled="{{decorOwned[item.id] || buying}}" data-id="{{item.id}}" bindtap="onBuyDecor">{{decorOwned[item.id] ? '已拥有' : '⚡' + item.price}}</button>
      </view>
    </view>
    <view class="shop-tip">装饰买一次即可永久装扮该科目农场，会显示在农场场景里。</view>
  </view>

  <view class="btn-row">
    <button class="btn ghost" bindtap="goPoints">💎 能量规则</button>
    <button class="btn primary" bindtap="goEarn">去打卡赚能量 ›</button>
  </view>
</view>
