<view class="wrap">
  <view class="hdr"><view class="hi">我的星球<text class="small">每一次坚持，都在让它成长</text></view></view>
  <view class="planet-big">
    <view class="stars"></view>
    <view class="p">{{stageEmoji}}</view>
    <view class="planet-lvl">Lv.{{level}} · {{stageName}} · ⚡{{energy}}</view>
  </view>
  <view class="sec-t">📅 连续打卡 {{streak}} 天 <text class="tag y">🔥 保持中</text></view>
  <view class="card">
    <view class="week">
      <view wx:for="{{week}}" wx:key="s" class="d">
        <view class="cir {{item.on ? 'on' : ''}} {{item.today ? 'today' : ''}}">{{item.on ? '✓' : item.label}}</view>
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>
  <view class="sec-t">🏅 成就徽章 <text class="tag y">{{unlockedCount}}/{{badgeList.length}} 已解锁</text></view>
  <view class="card">
    <view class="badges">
      <view class="badge {{item.unlocked ? '' : 'lock'}}" wx:for="{{badgeList}}" wx:key="id">
        <view class="bi">{{item.unlocked ? item.emoji : '🔒'}}</view>
        <text>{{item.name}}</text>
      </view>
    </view>
    <view class="badge-tip">答对题目、坚持打卡、攻克错题即可逐步解锁徽章</view>
  </view>
  <button class="btn ghost points-entry" bindtap="goPoints">💎 能量怎么算？查看积分规则与晋级路线 ›</button>
</view>