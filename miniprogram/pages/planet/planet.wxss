/* 探索页 · 风格统一（方案 C）：浅色页 + 深空场景卡 + 白卡体系，与其他 tab 页同一套组件语言 */
page { background: #f5f6fb; }
.page { padding: 28rpx 28rpx 60rpx; color: var(--ink); min-height: 100vh; box-sizing: border-box; }

/* 场景卡：深空只活在卡片里 */
.scene { position: relative; border-radius: 28rpx; overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(20, 24, 70, .28); }
.scene-img { width: 100%; height: 460rpx; display: block; animation: sceneFloat 9s ease-in-out infinite alternate; }
@keyframes sceneFloat { from { transform: scale(1.0); } to { transform: scale(1.07); } }
.scene-shade { position: absolute; left: 0; right: 0; bottom: 0; height: 190rpx;
  background: linear-gradient(180deg, rgba(4, 6, 20, 0), rgba(4, 6, 20, .78)); }
.scene-decors { position: absolute; top: 16rpx; left: 18rpx; display: flex; gap: 10rpx; }
.sd { font-size: 36rpx; filter: drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, .6)); }
.bal-pill { position: absolute; top: 16rpx; right: 18rpx; font-size: 26rpx; font-weight: 800; color: #ffd76a;
  background: rgba(6, 10, 28, .62); border: 1rpx solid rgba(255, 215, 106, .45); padding: 10rpx 22rpx; border-radius: 999rpx; }
.scene-cap2 { position: absolute; left: 24rpx; bottom: 22rpx; right: 170rpx; }
.sc-name { font-size: 36rpx; font-weight: 800; color: #fff; text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, .8); }
.sc-sub { font-size: 22rpx; color: #c9d6ff; margin-top: 6rpx; text-shadow: 0 1rpx 8rpx rgba(0, 0, 0, .8); }
.scene-detail2 { position: absolute; right: 22rpx; bottom: 26rpx; font-size: 23rpx; color: #dbeafe;
  text-shadow: 0 1rpx 8rpx rgba(0, 0, 0, .85); }

/* 白卡通用 */
.card { margin-top: 24rpx; background: #fff; border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(40, 45, 90, .06); padding: 26rpx 28rpx; }
.sec-title { font-size: 30rpx; font-weight: 800; color: var(--ink); }
.sec-tip { font-size: 22rpx; font-weight: 400; color: var(--muted); margin-left: 10rpx }

/* 成长 */
.g-top { font-size: 26rpx; font-weight: 700; color: var(--ink); }
.bar { margin-top: 16rpx; height: 18rpx; border-radius: 10rpx; background: #eef0f6; overflow: hidden; }
.bar-in { height: 100%; border-radius: 10rpx; background: linear-gradient(90deg, var(--brand), var(--brand2)); transition: width .6s ease; }
.bar-in.gold { background: linear-gradient(90deg, #f59e0b, #ffd76a); }
.g-next { margin-top: 14rpx; font-size: 24rpx; color: #5a6180; }
.g-desc { margin-top: 12rpx; font-size: 24rpx; line-height: 1.6; color: var(--muted); }
.base-box { margin-top: 24rpx; padding-top: 22rpx; border-top: 2rpx solid var(--line); }
.base-head { display: flex; justify-content: space-between; align-items: center; }
.base-title { font-size: 27rpx; font-weight: 800; color: var(--ink); }
.base-num { font-size: 24rpx; color: #e8a00c; font-weight: 700; }

/* 地图横幅 */
.map-card { display: flex; align-items: center; gap: 20rpx; }
.map-nodes { display: flex; flex-shrink: 0; }
.mn-img { width: 76rpx; height: 76rpx; border-radius: 50%; border: 3rpx solid #dfe3f2; margin-left: -16rpx; background: #0a1030; }
.mn-img:first-child { margin-left: 0; }
.mn-img.locked { filter: grayscale(1); opacity: .55; }
.map-main { flex: 1; min-width: 0; }
.map-t { font-size: 29rpx; font-weight: 800; color: var(--ink); }
.map-s { font-size: 22rpx; color: var(--muted); margin-top: 5rpx; }
.map-arr { font-size: 36rpx; color: #c3c9d8; }

/* 成长记录 */
.hist-link { display: flex; justify-content: space-between; align-items: center; margin-top: 26rpx; padding: 0 6rpx;
  font-size: 26rpx; font-weight: 700; color: var(--ink); }
.hl-arr { font-size: 23rpx; color: var(--muted); font-weight: 400; }
.hist-card { margin-top: 14rpx; }
.hist-row { display: flex; justify-content: space-between; padding: 16rpx 2rpx; border-bottom: 2rpx solid var(--line); }
.hist-row:last-child { border-bottom: none; }
.hist-lv { font-size: 26rpx; font-weight: 700; color: var(--ink); }
.hist-at { font-size: 24rpx; color: var(--muted); }
.hist-empty { font-size: 24rpx; color: var(--muted); padding: 14rpx 0 4rpx; }

/* 商城 */
.tabs { display: flex; background: #eceef6; border-radius: 999rpx; padding: 6rpx; margin-top: 20rpx; }
.tab { flex: 1; text-align: center; padding: 14rpx 0; font-size: 25rpx; font-weight: 600; border-radius: 999rpx; color: #6a7192; }
.tab.on { background: #fff; color: var(--ink); font-weight: 800; box-shadow: 0 4rpx 14rpx rgba(40, 45, 90, .10); }
.shop-hint { font-size: 22rpx; color: var(--muted); margin-top: 16rpx; }
.item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 2rpx solid var(--line); }
.item:last-child { border-bottom: none; }
.it-emoji { font-size: 48rpx; width: 76rpx; text-align: center; flex-shrink: 0; }
.it-img { width: 84rpx; height: 84rpx; border-radius: 50%; margin-right: 18rpx; flex-shrink: 0; }
.it-main { flex: 1; margin-left: 8rpx; min-width: 0; }
.it-name { display: block; font-size: 27rpx; font-weight: 700; color: var(--ink); }
.it-desc { display: block; font-size: 22rpx; color: var(--muted); margin-top: 4rpx; line-height: 1.5; }
.it-growth { display: block; font-size: 21rpx; color: var(--brand); margin-top: 4rpx; }
.it-btn { font-size: 24rpx; font-weight: 700; color: #fff; background: linear-gradient(90deg, var(--brand), var(--brand2));
  padding: 14rpx 22rpx; border-radius: 999rpx; white-space: nowrap; flex-shrink: 0; }
.it-btn.owned { background: #eef0f4; color: #8a90a8; }
.it-btn.locked { background: #eef0f4; color: #8a90a8; }

.foot { margin-top: 34rpx; text-align: center; font-size: 22rpx; color: #b7bbcf; padding: 10rpx 0; }
