.hdr{display:flex;align-items:flex-start;justify-content:space-between;margin:8rpx 0 24rpx}
.hi{font-size:36rpx;font-weight:700;color:var(--ink)}
.hi .small{display:block;font-size:22rpx;font-weight:400;color:var(--muted);margin-top:8rpx}
.energy-pill{background:linear-gradient(135deg,#ffd76a,#ff9d3c);color:#7a4a00;font-size:24rpx;font-weight:700;padding:12rpx 22rpx;border-radius:40rpx;white-space:nowrap}

/* 科目切换 */
.subj-tabs{white-space:nowrap;margin-bottom:22rpx}
.subj-tab{display:inline-flex;flex-direction:column;align-items:center;justify-content:center;width:120rpx;height:110rpx;background:#fff;border-radius:24rpx;margin-right:16rpx;box-shadow:0 6rpx 20rpx rgba(60,70,120,.06);border:3rpx solid transparent}
.subj-tab.on{border-color:var(--brand);background:linear-gradient(160deg,#eef0ff,#f7f8ff)}
.st-emoji{font-size:44rpx;line-height:1}
.st-name{font-size:22rpx;color:var(--muted);margin-top:6rpx}
.subj-tab.on .st-name{color:var(--brand);font-weight:700}

/* 农场场景 */
.farm-scene{border-radius:32rpx;overflow:hidden;margin-bottom:28rpx;box-shadow:0 10rpx 30rpx rgba(60,70,120,.1)}
.sky{height:150rpx;background:linear-gradient(180deg,#8fd3ff,#d9f0ff);position:relative}
.sky .sun{position:absolute;right:36rpx;top:22rpx;font-size:56rpx;animation:sunspin 12s linear infinite}
@keyframes sunspin{0%,100%{transform:rotate(0)}50%{transform:rotate(25deg)}}
.sky .cloud{position:absolute;font-size:48rpx;opacity:.9;animation:drift 9s ease-in-out infinite}
.sky .c1{left:30rpx;top:30rpx}
.sky .c2{left:190rpx;top:60rpx;font-size:36rpx;opacity:.7;animation-delay:-4s}
@keyframes drift{0%,100%{transform:translateX(0)}50%{transform:translateX(26rpx)}}
.ground{height:250rpx;background:linear-gradient(180deg,#a8e6a1,#7ecb76);position:relative;overflow:hidden}

/* 远景装饰：贴着地平线，稍小、半透明 */
.decor-back{position:absolute;top:6rpx;left:14rpx;right:14rpx;display:flex;justify-content:space-between;z-index:1}
.decor-back .bd-item{font-size:44rpx;opacity:.9;filter:drop-shadow(0 4rpx 4rpx rgba(0,0,0,.12))}

/* 宠物跑道：在草地里左右跑来跑去，偶尔停下 */
.pet-lane{position:absolute;left:0;right:0;bottom:20rpx;height:216rpx;z-index:3;display:flex;align-items:flex-end;justify-content:center}
/* 位移动画：0-30%向右跑到右端，30-42%站着，42-72%向左跑回，72-84%站着，84-100%小幅溜达 */
.pet-lane.roaming .pet-move{animation:roam 16s ease-in-out infinite}
@keyframes roam{
  0%{transform:translateX(-190rpx)}
  12%{transform:translateX(0)}
  30%{transform:translateX(190rpx)}
  42%{transform:translateX(190rpx)}
  58%{transform:translateX(0)}
  72%{transform:translateX(-190rpx)}
  84%{transform:translateX(-190rpx)}
  92%{transform:translateX(-120rpx)}
  100%{transform:translateX(-190rpx)}
}
.pet-move{display:inline-block;position:relative;transform-origin:bottom center}
/* 跑动颠簸 + 轻微前倾（不做 scaleX 镜像翻转，避免纸片压扁成一根线） */
.pet-lane.roaming .pet-scale{animation:faceBounce 16s ease-in-out infinite}
@keyframes faceBounce{
  0%{transform:translateY(0) rotate(0)}
  12%{transform:translateY(-3rpx) rotate(-3deg)}
  30%{transform:translateY(0) rotate(0)}
  42%{transform:translateY(0) rotate(0)}
  50%{transform:translateY(0) rotate(0)}
  58%{transform:translateY(-3rpx) rotate(3deg)}
  72%{transform:translateY(0) rotate(0)}
  84%{transform:translateY(0) rotate(0)}
  92%{transform:translateY(-2rpx) rotate(-2deg)}
  100%{transform:translateY(0) rotate(0)}
}
/* display:block 关键：inline-block 会在脚下生成匿名行框留下 descender 空隙，导致兔子看着悬浮 */
.pet-scale{position:relative;display:block;transform-origin:bottom center}
/* 未领养/无动画时：仅呼吸 */
.pet-lane.locked .pet-scale{animation:breathe 2.4s ease-in-out infinite}
@keyframes breathe{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-6rpx) scale(1.04)}}
.pet-face{display:block;line-height:1;filter:drop-shadow(0 8rpx 8rpx rgba(0,0,0,.22))}
.pet-img{display:block;filter:drop-shadow(0 10rpx 10rpx rgba(0,0,0,.25));animation:imgidle 2.6s ease-in-out infinite}
@keyframes imgidle{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-4rpx) rotate(2deg)}}
/* 3D序列帧兔子：视窗裁切 + image 平移切帧（小程序不支持本地图做 background-image） */
/* 视窗宽度=单帧宽，overflow 裁掉其余帧；image 宽=5倍单帧宽，translateX 每 -20% 切一帧 */
.pet3d{display:block;position:relative;overflow:hidden}
.pet3d-img{display:block;transform:translateX(0);will-change:transform}
.pet-lane.roaming .pet3d-img{animation:spritePlay 16s step-end infinite}
@keyframes spritePlay{
  0%{transform:translateX(0)}
  6%{transform:translateX(-20%)}
  12%{transform:translateX(-40%)}
  18%{transform:translateX(-20%)}
  24%{transform:translateX(-40%)}
  30%{transform:translateX(0)}
  42%{transform:translateX(0)}
  48%{transform:translateX(-20%)}
  54%{transform:translateX(-40%)}
  60%{transform:translateX(-20%)}
  66%{transform:translateX(-40%)}
  72%{transform:translateX(0)}
  84%{transform:translateX(0)}
  90%{transform:translateX(-60%)}
  96%{transform:translateX(-80%)}
  100%{transform:translateX(0)}
}
.pet-lane.locked .pet3d{filter:grayscale(1);opacity:.5}
/* 点击蹦跳：叠加在瞬时，优先级高于循环动画 */
.pet-lane .pet-scale.bouncing{animation:petjump .62s cubic-bezier(.28,.84,.42,1) !important}
@keyframes petjump{0%{transform:translateY(0) scaleX(1)}30%{transform:translateY(-56rpx) scaleX(1)}60%{transform:translateY(0) scaleX(1)}80%{transform:translateY(-10rpx) scaleX(1)}100%{transform:translateY(0) scaleX(1)}}
.pet-crown{position:absolute;top:-30rpx;left:50%;transform:translateX(-50%);font-size:46rpx;z-index:4;filter:drop-shadow(0 3rpx 5rpx rgba(0,0,0,.2));animation:crownshine 1.8s ease-in-out infinite}
@keyframes crownshine{0%,100%{transform:translateX(-50%) rotate(-6deg)}50%{transform:translateX(-50%) rotate(6deg)}}
/* 阴影紧贴兔子脚底：高度收窄 + 顶部负 margin 让最深处落在脚掌正下方 */
.pet-shadow{width:110rpx;height:14rpx;margin:-5rpx auto 0;background:radial-gradient(ellipse,rgba(0,0,0,.34),rgba(0,0,0,0) 72%);border-radius:50%;animation:shadowpulse 2.4s ease-in-out infinite}
.pet-shadow.img-shadow{width:150rpx}
@keyframes shadowpulse{0%,100%{transform:scaleX(1);opacity:.9}50%{transform:scaleX(.86);opacity:.7}}
.pet-lane.locked .pet-face,.pet-lane.locked .pet-img{filter:grayscale(1);opacity:.5;animation:none}
.pet-lane.locked .pet-shadow{opacity:.35}
.pet-bubble{position:absolute;top:-46rpx;left:50%;transform:translateX(-50%);background:#fff;color:#5a4632;font-size:22rpx;font-weight:600;padding:8rpx 18rpx;border-radius:22rpx 22rpx 22rpx 6rpx;white-space:nowrap;box-shadow:0 6rpx 16rpx rgba(60,70,120,.18);z-index:5;animation:bubblein .25s ease-out}
.pet-bubble::after{content:'';position:absolute;left:22rpx;bottom:-12rpx;border:7rpx solid transparent;border-top-color:#fff}
@keyframes bubblein{0%{opacity:0;transform:translateX(-50%) translateY(10rpx) scale(.9)}100%{opacity:1;transform:translateX(-50%) translateY(0) scale(1)}}
.animal-lock{position:absolute;top:40%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,.55);color:#fff;font-size:22rpx;padding:8rpx 18rpx;border-radius:30rpx;white-space:nowrap;z-index:6}

/* 近景装饰：贴着草地底部，遮挡宠物脚部形成景深 */
.decor-front{position:absolute;bottom:4rpx;left:10rpx;right:10rpx;display:flex;justify-content:space-around;z-index:4;pointer-events:none}
.decor-front .fd-item{font-size:50rpx;filter:drop-shadow(0 3rpx 3rpx rgba(0,0,0,.12));animation:sway 3.2s ease-in-out infinite}
@keyframes sway{0%,100%{transform:rotate(-4deg)}50%{transform:rotate(4deg)}}
.farm-info{background:#fff;padding:24rpx 28rpx}
.farm-title{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:16rpx}
.farm-title .fn{font-size:32rpx;font-weight:700;color:var(--ink)}
.farm-title .pet{font-size:24rpx;color:var(--muted)}
.growth-bar{height:18rpx;background:var(--soft);border-radius:20rpx;overflow:hidden}
.growth-fill{height:100%;background:linear-gradient(90deg,#7ee8a0,#3ec27a);border-radius:20rpx;transition:width .3s}
.growth-meta{display:flex;justify-content:space-between;font-size:21rpx;color:var(--muted);margin-top:10rpx}

/* 商店 */
.sec-t{font-size:30rpx;font-weight:700;color:var(--ink);margin:6rpx 0 18rpx;display:flex;align-items:center;gap:12rpx}
.tag{font-size:20rpx;font-weight:400;padding:4rpx 14rpx;border-radius:30rpx}
.tag.y{background:#fff3d8;color:#c07a00}
.shop-tabs{display:flex;background:#eef0f8;border-radius:24rpx;padding:6rpx;margin-bottom:18rpx}
.shop-tab{flex:1;text-align:center;font-size:25rpx;color:var(--muted);padding:14rpx 0;border-radius:20rpx}
.shop-tab.on{background:#fff;color:var(--brand);font-weight:700;box-shadow:0 4rpx 14rpx rgba(60,70,120,.08)}
.shop-card{padding:24rpx}
.shop-item{display:flex;align-items:center;gap:20rpx}
.si-emoji{font-size:80rpx;width:100rpx;text-align:center}
.si-body{flex:1}
.si-name{font-size:28rpx;font-weight:700;color:var(--ink)}
.si-desc{font-size:22rpx;color:var(--muted);margin-top:6rpx}
.buy-btn{background:linear-gradient(135deg,#ffd76a,#ff9d3c);color:#7a4a00;font-size:26rpx;font-weight:700;padding:14rpx 26rpx;border-radius:40rpx;border:none;line-height:1.4}
.buy-btn.small{font-size:22rpx;padding:10rpx 0;width:100%;margin-top:12rpx}
.buy-btn.owned{background:var(--soft);color:var(--muted)}
.buy-btn[disabled]{opacity:.6}
.shop-tip{font-size:21rpx;color:var(--muted);line-height:1.6;margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid var(--line)}
.shop-grid{display:flex;flex-wrap:wrap;gap:18rpx}
.food-item{width:calc(33.33% - 12rpx);background:var(--soft);border-radius:22rpx;padding:18rpx 12rpx;text-align:center}
.fi-emoji{font-size:62rpx;line-height:1}
.fi-name{font-size:24rpx;font-weight:700;color:var(--ink);margin-top:8rpx}
.fi-desc{font-size:19rpx;color:var(--muted);margin-top:6rpx;min-height:52rpx}

.btn-row{display:flex;gap:18rpx;margin-top:8rpx}
.btn-row .btn{flex:1}
