.wrap{padding:32rpx}
.hd{margin-bottom:28rpx}
.hd-t{font-size:40rpx;font-weight:900;color:#232845}
.hd-s{font-size:24rpx;color:var(--muted);margin-top:10rpx}
.card{background:#fff;border-radius:26rpx;padding:32rpx;box-shadow:0 6rpx 24rpx rgba(91,108,246,.06);margin-bottom:24rpx}
.sum{padding:28rpx 16rpx}
.sum-grid{display:flex}
.sum-i{flex:1;text-align:center}
.sum-n{font-size:36rpx;font-weight:900;color:#232845}
.sum-l{font-size:20rpx;color:#98a0b8;margin-top:6rpx}
.seg{display:flex;background:#eceef6;border-radius:999rpx;padding:6rpx;margin-bottom:24rpx}
.seg-i{flex:1;text-align:center;font-size:26rpx;font-weight:600;color:#6a7192;padding:14rpx 0;border-radius:999rpx}
.seg-i.on{background:#fff;color:var(--ink);font-weight:800;box-shadow:0 4rpx 14rpx rgba(40,45,90,.10)}
.row-hd{display:flex;align-items:center;gap:14rpx}
.row-arr{margin-left:auto;color:#c3c9d8;font-size:36rpx}
.row-t{font-size:30rpx;font-weight:800;color:#232845}
.row-tag{font-size:20rpx;font-weight:700;color:#fff;background:var(--brand);border-radius:999rpx;padding:4rpx 14rpx}
.row-range{font-size:22rpx;color:#98a0b8;margin-top:8rpx}
.row-stats{display:flex;gap:28rpx;margin-top:18rpx;font-size:24rpx;color:#5a6180;flex-wrap:wrap}
.rs-b{font-weight:800;color:#232845}
.bar{height:12rpx;background:#eef0f8;border-radius:999rpx;margin-top:18rpx;overflow:hidden}
.bar-fill{height:100%;background:linear-gradient(90deg,#5b6cf6,#8a5cf6);border-radius:999rpx}
.empty{text-align:center;color:#98a0b8;font-size:26rpx;padding:48rpx 32rpx}

/* 学习热力图 */
.heat-card{padding:26rpx 28rpx}
.heat-hd{display:flex;align-items:baseline;gap:14rpx;margin-bottom:18rpx}
.heat-t{font-size:29rpx;font-weight:800;color:var(--ink)}
.heat-s{font-size:22rpx;color:var(--muted)}
.heat{display:flex;gap:5rpx}
.heat-col{flex:1;display:flex;flex-direction:column;gap:5rpx}
.heat-cell{height:26rpx;border-radius:6rpx;background:#eceef5}
.heat-cell.lv1{background:#b9c4f7}
.heat-cell.lv2{background:#7d8ff2}
.heat-cell.lv3{background:#4a5ed7}
.heat-cell.fut{opacity:.35}
.heat-cell.cur{box-shadow:inset 0 0 0 2rpx #ffb020}
.heat-lg{display:flex;align-items:center;gap:6rpx;justify-content:flex-end;margin-top:14rpx;font-size:20rpx;color:var(--muted)}
.heat-lg .heat-cell{width:22rpx;height:22rpx;flex:none}
.share-row{display:flex;justify-content:flex-end;margin-top:16rpx}
.share-btn{font-size:24rpx;font-weight:700;color:var(--brand);background:#eef0fe;border-radius:999rpx;padding:10rpx 22rpx}
.share-canvas{position:fixed;left:-10000rpx;top:0;width:750px;height:1000px}
