page { background: #060a1c; }
.page { min-height: 100vh; color: #e8edff; box-sizing: border-box; padding-bottom: 48rpx; }
.hero { position: relative; display: flex; flex-direction: column; align-items: center; padding: 56rpx 0 30rpx; }
.hero-img { width: 380rpx; height: 380rpx; border-radius: 50%; box-shadow: 0 0 60rpx rgba(90, 140, 255, .35); animation: breathe 5s ease-in-out infinite; position: relative; z-index: 1; }
@keyframes breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.03); } }
.orbit { position: absolute; top: 26rpx; width: 440rpx; height: 440rpx; border: 2rpx solid rgba(140, 180, 255, .28); border-radius: 50%; animation: spin 14s linear infinite; }
.orbit-dot { position: absolute; top: -11rpx; left: 50%; margin-left: -11rpx; width: 22rpx; height: 22rpx; border-radius: 50%; background: #ffe9b0; box-shadow: 0 0 16rpx rgba(255, 233, 176, .95); }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.sig-ring { position: absolute; top: 150rpx; width: 560rpx; height: 190rpx; border: 12rpx solid rgba(240, 210, 140, .92); border-radius: 50%; transform: rotate(-18deg); z-index: 2; }
.sig-halo { position: absolute; top: 32rpx; width: 428rpx; height: 428rpx; border: 6rpx solid rgba(255, 216, 130, .75); border-radius: 50%; box-shadow: 0 0 40rpx rgba(255, 200, 90, .55), inset 0 0 30rpx rgba(255, 200, 90, .35); z-index: 2; }
.sig-comp { position: absolute; top: 62rpx; right: 96rpx; width: 92rpx; height: 92rpx; border-radius: 50%; background: #ffe9b0; box-shadow: 0 0 30rpx rgba(255, 233, 176, .95); z-index: 2; }
.sig-mark { position: absolute; top: 44rpx; right: 110rpx; font-size: 76rpx; z-index: 2; }
.hero-name { font-size: 44rpx; font-weight: 800; margin-top: 30rpx; }
.hero-sub { font-size: 25rpx; color: #9fb4ff; margin-top: 8rpx; }
.hero-state { margin-top: 16rpx; font-size: 23rpx; color: #0b1030; background: #ffd76a; padding: 6rpx 20rpx; border-radius: 16rpx; font-weight: 700; }
.scene { width: 702rpx; margin: 6rpx 24rpx 0; border-radius: 22rpx; display: block; }
.card { margin: 24rpx 24rpx 0; background: rgba(125, 160, 255, .07); border: 1rpx solid rgba(140, 170, 255, .22); border-radius: 22rpx; padding: 26rpx; }
.sec-title { font-size: 30rpx; font-weight: 800; margin-bottom: 14rpx; }
.fact { display: flex; padding: 12rpx 0; border-bottom: 1rpx solid rgba(140, 170, 255, .12); }
.f-k { width: 110rpx; flex-shrink: 0; font-size: 25rpx; color: #8fa8e8; }
.f-v { flex: 1; font-size: 26rpx; color: #e8efff; }
.detail { font-size: 27rpx; line-height: 1.75; color: #dbe6ff; margin-top: 20rpx; }
.desc { font-size: 25rpx; line-height: 1.7; color: #9fb4ff; margin-top: 14rpx; }
.need { font-size: 24rpx; color: #7dd3fc; margin-top: 18rpx; }
.sign-desc { font-size: 26rpx; line-height: 1.7; color: #c9d6ff; }
.sign-row { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; }
.sign-bal { font-size: 25rpx; color: #ffd76a; }
.sign-btn { background: linear-gradient(90deg, #2f6bff, #7a4dff); color: #fff; font-size: 26rpx; font-weight: 700; padding: 14rpx 30rpx; border-radius: 999rpx; }
.sign-btn.owned { background: rgba(255, 255, 255, .12); color: #8fa2d8; }
.sign-btn.locked { background: rgba(255, 255, 255, .10); color: #8fa2d8; }
