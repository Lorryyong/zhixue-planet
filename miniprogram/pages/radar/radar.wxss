.subj-bar{white-space:nowrap;margin-bottom:20rpx}
.subj{display:inline-block;font-size:25rpx;color:var(--muted);background:var(--soft);border-radius:24rpx;padding:12rpx 28rpx;margin-right:14rpx}
.subj.on{background:var(--brand);color:#fff;font-weight:700}
.radar-card{display:flex;flex-direction:column;align-items:center;padding:20rpx}
.radar{width:300px;height:290px}
.empty-mini{font-size:22rpx;color:var(--muted);text-align:center;padding:10rpx 20rpx}
.blind{padding:22rpx 0;border-bottom:2rpx solid var(--line)}
.blind:last-child{border:none}
.b1{display:flex;justify-content:space-between;font-size:26rpx;margin-bottom:12rpx}
.b1 .b{color:var(--red);font-weight:800}
.blind-book{font-size:21rpx;color:#4a72c4;background:#eef4ff;border-radius:10rpx;padding:4rpx 12rpx;margin:-2rpx 0 12rpx;display:inline-block}
.bar{height:14rpx;background:var(--line);border-radius:14rpx;overflow:hidden}
.bar .fill{height:100%;background:linear-gradient(90deg,#ff8a5c,var(--red));border-radius:14rpx}