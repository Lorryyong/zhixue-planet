.qcard{background:#fff;border-radius:28rpx;padding:28rpx;margin-bottom:22rpx;border-left:8rpx solid var(--brand)}
.qcard.done{border-left-color:var(--mint);opacity:.75}
.qh{display:flex;justify-content:space-between;align-items:center;margin-bottom:14rpx}
.no{font-size:26rpx;font-weight:800;color:var(--brand)}
.stem{font-size:27rpx;line-height:1.6;margin-bottom:14rpx}
.opts{font-size:24rpx;color:#5a6180;line-height:1.9}
.know{margin-top:14rpx;display:flex;gap:10rpx;flex-wrap:wrap}
.confirm{display:flex;gap:16rpx;margin-top:18rpx}
.confirm button{flex:1;font-size:24rpx;padding:14rpx;border-radius:16rpx;border:none;line-height:1.4}
.confirm .yes{background:#e4faf4;color:#12987f;font-weight:700}
.confirm .no{background:var(--soft);color:var(--muted)}
.card.empty{text-align:center;padding:50rpx}
.card.empty .ic{font-size:80rpx}

/* 编辑弹窗 */
.mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(20,24,45,.5);z-index:100;display:flex;align-items:center;justify-content:center;padding:32rpx}
.dialog{background:#fff;border-radius:28rpx;width:100%;max-height:88vh;overflow-y:auto;padding:32rpx}
.dlg-h{font-size:30rpx;font-weight:800;display:flex;justify-content:space-between;align-items:center;margin-bottom:20rpx}
.dlg-x{font-size:30rpx;color:var(--muted);padding:0 10rpx}
.field{margin-bottom:20rpx}
.field .lb{font-size:23rpx;color:var(--muted);margin-bottom:8rpx}
.inp{width:100%;box-sizing:border-box;background:#f5f6fb;border:1rpx solid #e6e8f2;border-radius:14rpx;padding:14rpx;font-size:25rpx;line-height:1.5;color:#2b3050}
.opt-row{display:flex;align-items:center;gap:12rpx;margin-bottom:10rpx}
.opt-key{flex:0 0 56rpx;height:56rpx;line-height:56rpx;text-align:center;border-radius:14rpx;background:#f0f1f8;color:#5a6180;font-weight:700;font-size:26rpx}
.opt-key.sel{background:var(--brand);color:#fff}
.opt-inp{flex:1}