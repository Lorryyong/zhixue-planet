/* 与全站统一的卡片风：白底、大圆角、柔和阴影，不用彩色侧边（2026-11-27 用户反馈） */
.qcard{background:#fff;border-radius:36rpx;padding:28rpx;margin-bottom:22rpx;box-shadow:0 12rpx 36rpx rgba(40,45,90,.055)}
.qcard.done{opacity:.75}
.qh{display:flex;justify-content:space-between;align-items:center;margin-bottom:14rpx}
.no{font-size:26rpx;font-weight:800;color:var(--brand)}
.stem{font-size:27rpx;line-height:1.6;margin-bottom:14rpx}
.opts{font-size:24rpx;color:#5a6180;line-height:1.9}
.know{margin-top:14rpx;display:flex;gap:10rpx;flex-wrap:wrap}
.confirm{display:flex;gap:16rpx;margin-top:18rpx}
.confirm button{flex:1;font-size:24rpx;padding:14rpx;border-radius:16rpx;border:none;line-height:1.4}
.confirm .yes{background:#e4faf4;color:#12987f;font-weight:700}
.confirm .yes.done{background:#d9f2ea;color:#0c7d68;font-weight:700;opacity:1}
.confirm .yes.done::after{border:none}
.confirm .no{background:var(--soft);color:var(--muted)}
.confirm .del{background:#fff5f4;color:#d92d20;font-weight:700}
.confirm .del::after{border:none}
.card.empty{text-align:center;padding:50rpx}
.card.empty .ic{font-size:80rpx}

/* 编辑弹窗 */
.mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(20,24,45,.5);z-index:100;display:flex;align-items:center;justify-content:center;padding:32rpx}
.dialog{background:#fff;border-radius:28rpx;width:100%;max-height:88vh;overflow-y:auto;padding:32rpx}
.dlg-h{font-size:32rpx;font-weight:800;display:flex;justify-content:space-between;align-items:center;margin-bottom:24rpx;position:sticky;top:0;background:#fff;z-index:2;padding-bottom:12rpx}
.dlg-x{font-size:32rpx;color:var(--muted);padding:0 10rpx}
.field{margin-bottom:26rpx}
.field .lb{font-size:26rpx;color:#5a6180;font-weight:600;margin-bottom:12rpx}
.meta-3{display:flex;gap:20rpx}
.meta-3 .meta-col{flex:1;min-width:0}
.inp{width:100%;box-sizing:border-box;background:#f5f6fb;border:1rpx solid #e6e8f2;border-radius:14rpx;padding:22rpx 20rpx;font-size:28rpx;line-height:1.6;min-height:88rpx;color:#2b3050}
.opt-row{display:flex;align-items:center;gap:12rpx;margin-bottom:10rpx}
.opt-key{flex:0 0 56rpx;height:56rpx;line-height:56rpx;text-align:center;border-radius:14rpx;background:#f0f1f8;color:#5a6180;font-weight:700;font-size:26rpx}
.opt-key.sel{background:var(--brand);color:#fff}
.opt-inp{flex:1}/* 全题型校对编辑 */
.qcard .tag.qt{background:#fff0e6;color:#e08a3c}
.qcard .tag.origin{background:#eef4ff;color:#4a72c4}
.qcard .tag.brushed{background:#e4faf4;color:#12987f}
.qcard .tag.unbrushed{background:#f0f1f6;color:#98a0b8}
.qcard .fix-tip{background:#fff2f0;color:#d9483b;font-size:22rpx;line-height:1.5;padding:12rpx 16rpx;border-radius:12rpx;margin-bottom:12rpx}
.ans-line{font-size:24rpx;color:var(--muted);line-height:1.6;margin-top:6rpx;word-break:break-all}
.picker-val{background:#f5f6fb;border:1rpx solid #e6e8f2;border-radius:14rpx;padding:22rpx 20rpx;font-size:28rpx;min-height:88rpx;line-height:1.6;color:#2b3050}
.blank-lb{flex:0 0 100rpx;font-size:26rpx;color:var(--muted)}
.pt-edit{display:flex;gap:12rpx;margin-bottom:14rpx;align-items:center}
.pt-name{flex:1}
.pt-score{flex:0 0 140rpx}
/* 结构化知识点：课本册次展示（题目卡片） */
.kp-list{margin-top:12rpx;background:#f7f8fd;border-radius:14rpx;padding:12rpx 16rpx}
.kp-line{display:flex;align-items:center;flex-wrap:wrap;gap:8rpx;font-size:23rpx;line-height:1.7;color:#4a5170}
.kp-dot{color:#8b93b3}
.kp-name{font-weight:600;color:#2b3050}
.kp-book{background:#eef4ff;color:#4a72c4;border-radius:10rpx;padding:2rpx 12rpx;font-size:21rpx}
.kp-book.todo{background:#fff3e6;color:#c07d2c}
.kp-auto{background:#f0f1f8;color:#98a0b8;border-radius:10rpx;padding:2rpx 10rpx;font-size:19rpx}
/* 结构化知识点编辑（弹窗） */
.kp-tip{font-size:21rpx;color:#98a0b8;line-height:1.5;margin:-4rpx 0 12rpx}
.kp-edit-row{display:flex;align-items:center;gap:10rpx;margin-bottom:12rpx}
.kp-edit-name{flex:1;min-width:0}
.kp-edit-book{flex:0 0 220rpx;min-height:88rpx;padding:22rpx 14rpx;font-size:23rpx;text-align:center}
.kp-del{flex:0 0 40rpx;text-align:center;color:#d9483b;font-size:28rpx;padding:8rpx}
/* 底部保存按钮固定在弹窗底部，避免被内容挤出屏幕 */
.dialog .save-edit{position:sticky;bottom:0;margin-top:12rpx}

/* 入库等候动画（全屏遮罩 + 旋转环） */
.submit-mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(20,24,60,.45);z-index:999;display:flex;align-items:center;justify-content:center}
.submit-box{background:#fff;border-radius:28rpx;padding:52rpx 56rpx 44rpx;display:flex;flex-direction:column;align-items:center;box-shadow:0 20rpx 50rpx rgba(0,0,0,.25)}
.spinner{width:68rpx;height:68rpx;border-radius:50%;border:8rpx solid #e3e6f5;border-top-color:#5b6cff;animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.submit-text{font-size:30rpx;font-weight:700;color:var(--ink);margin-top:30rpx}
.submit-sub{font-size:22rpx;color:var(--muted);margin-top:10rpx}
.group-del{text-align:center;font-size:26rpx;color:#d92d20;padding:30rpx 0 6rpx}
.lock-note{text-align:center;font-size:23rpx;color:var(--muted);margin-top:12rpx;padding:18rpx 0}
