<view class="wrap">
  <view class="hdr">
    <view class="hi">题目校对<text class="small">{{paperTitle}} · 共{{qs.length}}题</text></view>
    <text wx:if="{{qs.length}}" class="tag">{{confirmedCount}}/{{qs.length}}</text>
  </view>

  <view wx:if="{{!qs.length}}" class="card empty">
    <view class="ic">📭</view>
    <view class="hint">暂无待校对题目，去「试卷中心」上传一份试卷吧</view>
    <button class="btn ghost" style="margin-top:24rpx" bindtap="goPapers">去上传</button>
  </view>

  <block wx:for="{{qs}}" wx:key="id">
    <view class="qcard {{item.confirmed ? 'done' : ''}}">
      <view class="qh">
        <text class="no">第 {{item.no}} 题</text>
        <text class="tag qt">{{item.qTypeLabel}}</text>
        <text wx:if="{{item.original}}" class="tag origin">来源：{{item.original}}</text>
        <text wx:if="{{item.brushed}}" class="tag brushed">已刷</text>
        <text wx:else class="tag unbrushed">未刷</text>
      </view>
      <view wx:if="{{item.needFix && item.canEdit}}" class="fix-tip">⚠ {{item.issuesText}}（点「修改」补全）</view>
      <view wx:elif="{{item.needFix}}" class="fix-tip">⚠ {{item.issuesText}}（系统试卷请联系管理员修改）</view>
      <view class="stem">{{item.stem}}</view>
      <view wx:if="{{item.optText.length}}" class="opts"><view wx:for="{{item.optText}}" wx:for-item="o" wx:key="*this">{{o}}</view></view>
      <view class="ans-line">答案：{{item.answerText}}</view>
      <view wx:if="{{item.pointsText}}" class="ans-line">要点：{{item.pointsText}}</view>
      <view class="know"><text wx:for="{{item.tagNames}}" wx:for-item="t" wx:key="*this" class="tag">{{t}}</text></view>
      <view wx:if="{{item.kpList.length}}" class="kp-list">
        <view class="kp-line" wx:for="{{item.kpList}}" wx:for-item="k" wx:key="name">
          <text class="kp-dot">•</text><text class="kp-name">{{k.name}}</text>
          <text wx:if="{{k.book}}" class="kp-book">{{k.book}}</text>
          <text wx:else class="kp-book todo">课本待补</text>
          <text wx:if="{{k.inferred}}" class="kp-auto">自动</text>
        </view>
      </view>
      <view class="confirm">
        <!-- 确认按钮只在题目第一次录入（待确认）时保留；已入库题目不再显示确认状态按钮 -->
        <button wx:if="{{!item.confirmed}}" class="yes" bindtap="confirmQ" data-id="{{item.id}}">✓ 确认正确</button>
        <button wx:if="{{item.canEdit}}" class="no" bindtap="editTip" data-id="{{item.id}}">✎ 修改</button>
        <button wx:if="{{item.canDelete}}" class="del" bindtap="deleteQ" data-id="{{item.id}}">🗑 删除</button>
      </view>
    </view>
  </block>

  <button wx:if="{{qs.length && !lockedSystem}}" class="btn" style="margin-top:12rpx" disabled="{{submitting}}" bindtap="confirmAll">{{submitting ? '正在入库…' : (reEdit ? '保存修改并返回' : '确认全部并入库')}}</button>
  <view wx:if="{{lockedSystem}}" class="lock-note">系统试卷仅供查看，修改请到管理端「试卷管理」</view>

  <view wx:if="{{groupDel}}" class="group-del" bindtap="onDeleteGroup">删除整组试卷</view>

  <!-- 入库等候动画：全屏遮罩拦截点击，防重复提交 -->
  <view wx:if="{{submitting}}" class="submit-mask" catchtap="noop">
    <view class="submit-box">
      <view class="spinner"></view>
      <view class="submit-text">{{reEdit ? '正在保存…' : '正在入库，请稍候…'}}</view>
      <view class="submit-sub">题目较多时需要十几秒，请勿重复点击</view>
    </view>
  </view>


  <!-- 全题型题目编辑弹窗（v1.9.11 抽取为共享组件 question-editor） -->
  <question-editor
    visible="{{editing}}"
    question="{{editQuestion}}"
    save-text="保存并同步"
    bind:save="onEditorSave"
    bind:cancel="closeEdit" />
</view>
