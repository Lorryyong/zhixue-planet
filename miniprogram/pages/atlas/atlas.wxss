page { background: #060a1c; }
.page { min-height: 100vh; color: #e8edff; box-sizing: border-box; }
.viewport { width: 100%; overflow: hidden; position: relative; background: linear-gradient(180deg, #0a1030 0%, #0a0f2c 55%, #060a1c 100%); }
.world { position: absolute; left: 0; top: 0; transform-origin: 0 0; }
.star { position: absolute; background: #ffffff; border-radius: 50%; }
.seg { position: absolute; height: 0; border-top: 5px dashed rgba(110, 180, 255, .45); transform-origin: 0 50%; }
.seg.lit { border-top: 5px solid rgba(120, 200, 255, .9); box-shadow: 0 0 12px rgba(110, 190, 255, .55); }
.node { position: absolute; border-radius: 50%; }
.nimg { width: 100%; height: 100%; border-radius: 50%; display: block; }
.shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-radius: 50%; background: rgba(88, 102, 140, .52); box-shadow: inset 0 0 60px rgba(6, 10, 24, .55); }
.cur-ring { position: absolute; left: -16px; top: -16px; right: -16px; bottom: -16px; border: 5px solid #ffd76a; border-radius: 50%; box-shadow: 0 0 34px rgba(255, 215, 106, .45); }
.badge { position: absolute; left: -10px; top: -10px; min-width: 46px; height: 46px; padding: 0 6px; box-sizing: border-box; border-radius: 50%; background: rgba(6, 10, 24, .85); color: #ffd76a; font-size: 30px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.lock { position: absolute; right: -6px; bottom: -6px; font-size: 36px; }
.nlabel { position: absolute; text-align: center; color: #e8efff; font-size: 34px; font-weight: 600; text-shadow: 0 2px 8px rgba(0, 0, 0, .8); white-space: nowrap; }
.hint { font-size: 22rpx; color: #7e90c4; text-align: center; padding: 14rpx 20rpx 0; }
.card { margin: 18rpx 24rpx 40rpx; background: rgba(125, 160, 255, .07); border: 1rpx solid rgba(140, 170, 255, .22);
  border-radius: 22rpx; padding: 24rpx; }
.c-head { display: flex; align-items: center; }
.c-thumb { width: 64rpx; height: 64rpx; border-radius: 50%; margin-right: 16rpx; flex-shrink: 0; }
.c-lv { font-size: 31rpx; font-weight: 800; flex: 1; }
.c-state { font-size: 22rpx; color: #0b1030; background: #ffd76a; padding: 4rpx 14rpx; border-radius: 14rpx; font-weight: 700; }
.c-state.lock { background: rgba(255, 255, 255, .12); color: #8fa2d8; }
.c-region { font-size: 23rpx; color: #9fb4ff; margin-top: 8rpx; }
.c-desc { font-size: 25rpx; line-height: 1.65; color: #c9d6ff; margin-top: 12rpx; }
.c-need { font-size: 24rpx; color: #7dd3fc; margin-top: 14rpx; }

.zoomtools { position: fixed; right: 24rpx; top: 45vh; display: flex; flex-direction: column; gap: 14rpx; z-index: 5; }
.zbtn { width: 72rpx; height: 72rpx; border-radius: 50%; background: rgba(23, 32, 66, 0.88); border: 1px solid rgba(125, 211, 252, 0.45); color: #dbeafe; font-size: 40rpx; display: flex; align-items: center; justify-content: center; }
.zbtn.wide { width: 72rpx; height: 56rpx; border-radius: 28rpx; font-size: 22rpx; }
.sig-ring { position: absolute; left: -38%; top: 21%; width: 176%; height: 58%; border: 10px solid rgba(240, 210, 140, .92); border-radius: 50%; transform: rotate(-18deg); box-sizing: border-box; }
.sig-halo { position: absolute; left: -9%; top: -9%; right: -9%; bottom: -9%; border: 6px solid rgba(255, 216, 130, .75); border-radius: 50%; box-shadow: 0 0 34px rgba(255, 200, 90, .55), inset 0 0 24px rgba(255, 200, 90, .35); }
.sig-comp { position: absolute; right: -3%; top: -3%; width: 27%; height: 27%; border-radius: 50%; background: #ffe9b0; box-shadow: 0 0 22px rgba(255, 233, 176, .95), inset 0 0 8px rgba(255, 255, 255, .9); }
.sig-belt .bd { position: absolute; width: 11%; height: 11%; border-radius: 50%; background: #bcd9fb; box-shadow: 0 0 10px rgba(188, 217, 251, .9); }
.sig-belt .b1 { left: 16%; top: -13%; }
.sig-belt .b2 { left: 44.5%; top: -18%; }
.sig-belt .b3 { right: 16%; top: -13%; }
.sig-mark { position: absolute; right: -8%; top: -12%; }
.c-go { font-size: 23rpx; color: #7dd3fc; margin-top: 10rpx; }
