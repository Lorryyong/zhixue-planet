.hd{margin:8rpx 0 28rpx}
.hero{background:linear-gradient(135deg,var(--brand),var(--brand2));border-radius:32rpx;padding:32rpx;color:#fff;box-shadow:0 12rpx 36rpx rgba(91,108,246,.3);margin-bottom:30rpx}
.hero-top{display:flex;align-items:center;gap:22rpx}
.hero-p{font-size:80rpx;width:110rpx;text-align:center}
.hero-info{flex:1}
.hero-lv{font-size:26rpx;opacity:.92;font-weight:600}
.hero-num{font-size:48rpx;font-weight:800;margin-top:6rpx}
.hero-unit{font-size:24rpx;font-weight:500;opacity:.85}
.hero-streak{font-size:24rpx;background:rgba(255,255,255,.18);padding:10rpx 18rpx;border-radius:20rpx;white-space:nowrap}
.pbar{height:14rpx;background:rgba(255,255,255,.25);border-radius:10rpx;margin:26rpx 0 12rpx;overflow:hidden}
.pbar-fill{height:100%;background:linear-gradient(90deg,#ffd166,#ffb020);border-radius:10rpx}
.hero-next{font-size:22rpx;opacity:.9}
.hero-streak{white-space:nowrap}

.rule{display:flex;align-items:center;gap:20rpx;padding:18rpx 0;border-bottom:2rpx solid var(--line)}
.rule:last-of-type{border-bottom:none}
.rule-ic{font-size:44rpx;width:60rpx;text-align:center}
.rule-body{flex:1}
.rule-t{font-size:28rpx;font-weight:700}
.rule-d{font-size:22rpx;color:var(--muted);margin-top:4rpx;line-height:1.5}
.rule-delta{font-size:32rpx;font-weight:800;color:var(--amber)}
.formula{background:var(--soft);border-radius:18rpx;padding:20rpx 22rpx;margin-top:12rpx}
.formula-t{font-size:24rpx;font-weight:700;color:var(--ink)}
.formula-d{font-size:21rpx;color:var(--muted);margin-top:8rpx;line-height:1.6}

.path{padding-top:12rpx}
.path-item{display:flex;gap:20rpx;position:relative;padding:14rpx 0}
.path-dot{font-size:52rpx;width:80rpx;text-align:center;flex-shrink:0;filter:grayscale(1);opacity:.45;z-index:1}
.path-item.reached .path-dot,.path-item.cur .path-dot{filter:none;opacity:1}
.path-line{position:absolute;left:39rpx;top:78rpx;bottom:-14rpx;width:4rpx;background:var(--line)}
.path-item.reached .path-line{background:linear-gradient(var(--brand),var(--line))}
.path-body{flex:1;padding-top:6rpx;min-width:0}
.path-name{font-size:28rpx;font-weight:700}
.path-item:not(.reached) .path-name{color:var(--muted)}
.badge-now{font-size:20rpx;color:#fff;background:var(--mint);padding:4rpx 14rpx;border-radius:12rpx;margin-left:10rpx;vertical-align:middle}
.path-desc{font-size:22rpx;color:var(--muted);margin-top:6rpx}
.path-need{font-size:21rpx;color:var(--brand);margin-top:6rpx;font-weight:600}
.mini-bar{height:10rpx;background:var(--line);border-radius:8rpx;margin-top:10rpx;overflow:hidden;max-width:320rpx}
.mini-fill{height:100%;background:var(--brand);border-radius:8rpx}

.ledger-row{display:flex;align-items:center;padding:16rpx 0;border-bottom:2rpx solid var(--line)}
.ledger-row:last-child{border-bottom:none}
.ledger-r{flex:1;font-size:26rpx}
.ledger-delta{font-size:28rpx;font-weight:800}
.ledger-delta.plus{color:var(--red)}
.ledger-delta.minus{color:var(--mint)}
.empty{font-size:24rpx;color:var(--muted);text-align:center;padding:30rpx 0}
.full{width:100%;margin-top:16rpx}
