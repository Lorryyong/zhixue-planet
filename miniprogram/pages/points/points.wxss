/* 积分规则 · 现代风 v2：深空等级卡 + 12 级宇宙路线（与探索页同口径） */
.sec-t2{font-size:28rpx;font-weight:800;color:var(--ink);margin:30rpx 0 14rpx}
.lvcard{background:linear-gradient(135deg,#131c4d,#3b2a6d);border-radius:28rpx;padding:28rpx;color:#fff;box-shadow:0 14rpx 36rpx rgba(20,24,70,.35)}
.lv-top{display:flex;align-items:center;gap:20rpx}
.lv-node{width:92rpx;height:92rpx;border-radius:50%;border:3rpx solid rgba(160,190,255,.55);flex-shrink:0}
.lv-info{flex:1;min-width:0}
.lv-name{font-size:31rpx;font-weight:800}
.lv-num{font-size:23rpx;color:#c9d6ff;margin-top:6rpx}
.lv-streak{font-size:23rpx;background:rgba(255,255,255,.16);padding:9rpx 18rpx;border-radius:999rpx;white-space:nowrap}
.pbar{height:14rpx;background:rgba(255,255,255,.22);border-radius:10rpx;margin:24rpx 0 12rpx;overflow:hidden}
.pbar-fill{height:100%;background:linear-gradient(90deg,#ffd166,#ffb020);border-radius:10rpx}
.lv-next{font-size:22rpx;color:#c9d6ff}
.rule{display:flex;align-items:center;gap:20rpx;padding:18rpx 0;border-bottom:2rpx solid var(--line)}
.rule:last-of-type{border-bottom:none}
.rule-ic{width:72rpx;height:72rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;font-size:32rpx;flex-shrink:0}
.rule-body{flex:1;min-width:0}
.rule-t{font-size:27rpx;font-weight:700;color:var(--ink)}
.rule-d{font-size:22rpx;color:var(--muted);margin-top:4rpx;line-height:1.5}
.rule-delta{font-size:28rpx;font-weight:800;color:#e8a00c;white-space:nowrap}
.formula{background:var(--soft);border-radius:16rpx;padding:20rpx;margin-top:18rpx}
.formula-t{font-size:25rpx;font-weight:700;color:var(--ink);line-height:1.6}
.formula-d{font-size:22rpx;color:var(--muted);margin-top:8rpx;line-height:1.6}
.path-item{display:flex;align-items:center;gap:18rpx;padding:16rpx 0;border-bottom:2rpx solid var(--line)}
.path-item:last-child{border-bottom:none}
.path-item.cur{background:#f6f7ff;margin:0 -14rpx;padding-left:14rpx;padding-right:14rpx;border-radius:14rpx}
.path-node{width:64rpx;height:64rpx;border-radius:50%;flex-shrink:0}
.path-node.locked{filter:grayscale(1);opacity:.5}
.path-body{flex:1;min-width:0}
.path-name{font-size:26rpx;font-weight:700;color:var(--ink)}
.badge-now{font-size:20rpx;color:#fff;background:var(--brand);border-radius:999rpx;padding:3rpx 14rpx;margin-left:12rpx;vertical-align:2rpx}
.path-need{font-size:22rpx;color:var(--muted);white-space:nowrap}
.ledger-row{display:flex;align-items:center;justify-content:space-between;padding:15rpx 0;border-bottom:2rpx solid var(--line)}
.ledger-row:last-of-type{border-bottom:none}
.ledger-r{font-size:25rpx;color:var(--ink);flex:1;margin-right:16rpx}
.ledger-delta{font-size:26rpx;font-weight:800}
.ledger-delta.plus{color:#e8a00c}
.ledger-delta.minus{color:var(--muted)}
.empty{font-size:24rpx;color:var(--muted);text-align:center;padding:26rpx 0}
.btn.full{margin-top:18rpx}

/* 扁平图标 */
.rule-ic .ic-img{width:36rpx;height:36rpx}
