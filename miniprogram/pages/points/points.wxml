<view class="wrap">
  <view class="hd">
    <view class="hi">💎 积分与晋级说明<text class="small">每一次坚持，都在为星球积蓄能量</text></view>
  </view>

  <!-- 当前能量总览 -->
  <view class="hero">
    <view class="hero-top">
      <view class="hero-p">{{stageEmoji}}</view>
      <view class="hero-info">
        <view class="hero-lv">Lv.{{level}} · {{stageName}}</view>
        <view class="hero-num">⚡ {{energy}} <text class="hero-unit">能量</text></view>
      </view>
      <view class="hero-streak">🔥 {{streak}}天</view>
    </view>
    <view class="pbar"><view class="pbar-fill" style="width:{{energyPct}}%"></view></view>
    <view class="hero-next">{{stageNext}} · 连续打卡 {{streak}} 天</view>
  </view>

  <!-- 积分计算规则 -->
  <view class="sec-t">🧮 能量（积分）如何计算</view>
  <view class="card">
    <view class="rule" wx:for="{{rules}}" wx:key="title">
      <view class="rule-ic">{{item.icon}}</view>
      <view class="rule-body">
        <view class="rule-t">{{item.title}}</view>
        <view class="rule-d">{{item.desc}}</view>
      </view>
      <view class="rule-delta">{{item.delta}}</view>
    </view>
    <view class="formula">
      <view class="formula-t">每日能量 = 答对题 × 2 + 完成打卡 20 + 攻克错题 × 30</view>
      <view class="formula-d">答错不扣能量，但会进入错题本；按艾宾浩斯 1/3/7 天安排复习，连续答对即"攻克"并额外奖励。</view>
    </view>
  </view>

  <!-- 晋级路线 -->
  <view class="sec-t">🪐 知识星球晋级路线</view>
  <view class="card path">
    <view class="path-item {{item.current ? 'cur' : ''}} {{item.reached ? 'reached' : ''}}" wx:for="{{path}}" wx:key="level">
      <view class="path-dot">{{item.emoji}}</view>
      <view class="path-line" wx:if="{{index < path.length - 1}}"></view>
      <view class="path-body">
        <view class="path-name">Lv.{{item.level}} · {{item.name}} <text wx:if="{{item.current}}" class="badge-now">当前</text></view>
        <view class="path-desc">{{item.desc}}</view>
        <view class="path-need">{{item.min}} 能量解锁</view>
        <view class="mini-bar" wx:if="{{item.progress > 0 && item.progress < 100}}"><view class="mini-fill" style="width:{{item.progress}}%"></view></view>
      </view>
    </view>
  </view>

  <!-- 能量明细 -->
  <view class="sec-t">📜 最近能量明细</view>
  <view class="card">
    <view wx:if="{{ledger.length}}" class="ledger">
      <view class="ledger-row" wx:for="{{ledger}}" wx:key="id">
        <view class="ledger-r">{{item.reason}}</view>
        <view class="ledger-delta {{item.delta > 0 ? 'plus' : 'minus'}}">{{item.delta > 0 ? '+' : ''}}{{item.delta}}</view>
      </view>
    </view>
    <view wx:else class="empty">还没有能量记录，去首页完成一次打卡吧 ✨</view>
    <button class="btn ghost mini full" bindtap="goPlanet">查看我的星球 ›</button>
  </view>

  <view class="hint">能量仅用于学习激励与星球成长展示，不涉及任何付费或排名攀比。</view>
</view>
