<view class="wrap">
  <view class="hdr">
    <view wx:if="{{tab === 'library'}}" class="hi">试卷管理<small>全库试卷一览，可删除或将个人试卷转为系统试卷</small></view>
    <view wx:elif="{{tab === 'users'}}" class="hi">用户管理<small>查看全部注册用户与管理员设置</small></view>
    <view wx:else class="hi">题库批量导入<small>拍照 / PDF / Excel 三种方式，识别校对后发布为系统试卷</small></view>
  </view>

  <!-- 身份校验中 -->
  <view wx:if="{{checking}}" class="card">
    <view class="hint" style="margin:40rpx 0">正在校验管理员身份…</view>
  </view>

  <!-- 非管理员：给出加入白名单指引 -->
  <view wx:elif="{{!isAdmin}}" class="card">
    <view class="sec-t">🔒 需要管理员权限</view>
    <view class="hint" style="text-align:left;margin-bottom:18rpx">{{hint}}</view>
    <view class="id-box">
      <view class="id-label">你的 openid（点复制发给管理员）</view>
      <view class="id-value">{{openid || '未获取到'}}</view>
      <button class="btn ghost mini" style="margin-top:14rpx" bindtap="copyOpenid">📋 复制 openid</button>
    </view>
    <view class="hint" style="text-align:left;margin-top:18rpx">
      管理员二选一：① 腾讯云控制台 → importQuestions 云函数 → 环境变量 → 添加 ADMIN_OPENIDS = 你的openid（多个用英文逗号分隔）；② 在数据库 zx_admins 表插入一行 (openid)。配置后回到本页下拉刷新即可。
    </view>
    <button class="btn ghost mini" style="margin-top:18rpx" bindtap="checkIdentity">🔄 重新校验身份</button>
  </view>

  <!-- 管理员 -->
  <block wx:else>
    <!-- 用户管理（管理端「用户管理」入口带 tab=users 进入，保持兼容） -->
    <block wx:if="{{tab === 'users'}}">
      <view class="card">
        <view class="sec-t">注册用户（{{usersTotal}}）</view>
        <view wx:if="{{usersLoading}}" class="hint" style="margin:40rpx 0">加载中…</view>
        <view wx:elif="{{!users.length}}" class="hint" style="margin:40rpx 0">暂无用户，用户首次登录后会显示在这里。</view>
        <view wx:else class="user-list">
          <view class="user-row" wx:for="{{users}}" wx:key="openid">
            <image wx:if="{{item.avatar}}" class="u-av" src="{{item.avatar}}" mode="aspectFill"></image>
            <view wx:else class="u-av u-av-ph">🧑</view>
            <view class="u-info">
              <view class="u-name">{{item.nickname || '未设置昵称'}} <text wx:if="{{item.role === 'admin'}}" class="u-role">管理员</text></view>
              <view class="u-meta">注册 {{item.createdAt || '-'}}</view>
              <view class="u-meta">最近登录 {{item.lastLoginAt || '-'}}</view>
            </view>
          </view>
        </view>
        <button class="btn ghost mini" style="margin-top:18rpx" bindtap="loadUsers">🔄 刷新用户列表</button>
      </view>
    </block>

    <!-- 试卷管理：UX 与试卷中心一致（筛选面板 + 图标行 + 右侧按钮列）；功能逻辑不变 -->
    <block wx:elif="{{tab === 'library'}}">
      <view class="sec-t">试卷管理 <text class="tag g">全库 {{libTotalRows}} 行</text></view>

      <!-- 筛选面板（同试卷中心样式）：科目多选 + 范围；管理端数据无年级/省市/启用维度，故只列这两行 -->
      <view class="filter-panel">
        <view class="frow">
          <text class="frow-lb">科目</text>
          <view class="chips">
            <view class="chip {{libSubjectAll?'on':''}}" data-v="" bindtap="onLibFilterSubject">全部</view>
            <view wx:for="{{libSubjectOptions}}" wx:key="*this" class="chip {{libSelSubject[item]?'on':''}}" data-v="{{item}}" bindtap="onLibFilterSubject">{{item}}</view>
          </view>
        </view>
        <view class="frow">
          <text class="frow-lb">范围</text>
          <view class="chips">
            <view wx:for="{{libScopeOptions}}" wx:key="value" class="chip {{libFilterScope===item.value?'on':''}}" data-v="{{item.value}}" bindtap="onLibFilterScope">{{item.label}}</view>
          </view>
        </view>
      </view>
      <view wx:if="{{!libSubjectAll||libFilterScope}}" class="filter-reset" bindtap="resetLibFilter">✕ 清除筛选，显示全部</view>

      <view wx:if="{{libLoading}}" class="card"><view class="hint" style="margin:40rpx 0">加载中…</view></view>
      <view wx:elif="{{!libGroups.length}}" class="card"><view class="hint" style="margin:40rpx 0">暂无试卷。</view></view>
      <view wx:elif="{{!libShown.length}}" class="card"><view class="hint" style="margin:40rpx 0">没有符合筛选条件的试卷。</view></view>
      <view wx:else class="card lib-card">
        <view wx:for="{{libShown}}" wx:key="key" class="lib-group">
          <view class="lib-paper" bindtap="onLibGroupTap" data-key="{{item.key}}">
            <view class="lib-thumb" style="background:{{item.iconBg}}">{{item.icon}}</view>
            <view class="lib-info">
              <view class="lib-t2">{{item.original}}</view>
              <view class="lib-sp">{{item.subject}} · {{item.uniqueCount}} 题（{{item.copies}} 行）</view>
              <view class="lib-meta2">{{item.scope === 'system' ? '系统试卷' : '我的试卷'}}<text wx:if="{{item.scope !== 'system'}}"> · {{item.studentId}}</text></view>
            </view>
            <view class="lib-ops">
              <view wx:if="{{item.scope !== 'system'}}" class="lib-promote" catchtap="onLibPromote" data-key="{{item.key}}">转为系统</view>
              <view class="lib-del" catchtap="onLibDelSource" data-key="{{item.key}}">删除试卷</view>
            </view>
          </view>
          <view wx:if="{{libOpenKey === item.key}}" class="lib-qs">
            <view wx:if="{{libQLoading}}" class="hint">加载题目中…</view>
            <view wx:elif="{{!libQuestions.length}}" class="hint">该试卷暂无题目</view>
            <view wx:for="{{libQuestions}}" wx:for-item="q" wx:key="id" class="lib-q">
              <view class="lib-q-stem">{{q.stem}}</view>
              <view class="lib-q-del" catchtap="onLibDelQuestion" data-id="{{q.id}}">删除</view>
            </view>
          </view>
        </view>
      </view>
      <button class="btn ghost mini" style="margin-top:18rpx" bindtap="loadLibrary">🔄 刷新试卷列表</button>
    </block>

    <!-- 题库批量导入：仅拍照 / PDF / Excel 三种方式 -->
    <block wx:else>
      <view wx:if="{{bootstrapped}}" class="notice">✅ 你已成为首位管理员（已写入 zx_admins 表）。</view>

      <!-- 默认学科：拍照/PDF 识别时给 AI 的学科提示，Excel 以表内 subject 列为准 -->
      <view class="card subj-card">
        <view class="subj-line">
          <text class="subj-label">默认学科</text>
          <text class="subj-note">拍照 / PDF 识别的学科提示，可提升题型判断准确度</text>
        </view>
        <view class="subj-quick">
          <view wx:for="{{subjects}}" wx:key="*this" class="subj-q {{subject === item ? 'on' : ''}}" data-s="{{item}}" bindtap="onSubjectTap">{{item}}</view>
        </view>
      </view>

      <!-- 三种导入方式：纵向全宽卡片，窄屏也不会裁切 -->
      <view class="sec-t">选择导入方式</view>
      <view class="import-list">
        <view class="import-item {{importing ? 'disabled' : ''}}" bindtap="chooseImage">
          <view class="ii-ic ic-cam">📷</view>
          <view class="ii-body">
            <view class="ii-t">拍照导入</view>
            <view class="ii-d">拍摄试卷或相册选图，AI 识别后逐题校对</view>
          </view>
          <view class="ii-arrow">›</view>
        </view>
        <view class="import-item {{importing ? 'disabled' : ''}}" bindtap="choosePdf">
          <view class="ii-ic ic-pdf">📄</view>
          <view class="ii-body">
            <view class="ii-t">PDF 导入</view>
            <view class="ii-d">从微信选择 PDF 文件，AI 识别后逐题校对</view>
          </view>
          <view class="ii-arrow">›</view>
        </view>
        <view class="import-item {{importing ? 'disabled' : ''}}" bindtap="chooseExcel">
          <view class="ii-ic ic-xls">📊</view>
          <view class="ii-body">
            <view class="ii-t">Excel 导入</view>
            <view class="ii-d">按表格列头批量导入，解析后逐题校对</view>
          </view>
          <view class="ii-arrow">›</view>
        </view>
      </view>

      <view class="link-row" bindtap="showExcelHelp">📋 查看 Excel 列头格式要求</view>
      <view wx:if="{{importing}}" class="hint" style="margin-top:18rpx">处理中，请稍候…</view>
    </block>
  </block>
</view>
