.notice{background:#e4faf4;color:#12987f;font-size:24rpx;padding:18rpx 24rpx;border-radius:18rpx;margin-bottom:20rpx;font-weight:600}
.id-box{background:#f7f8fc;border-radius:18rpx;padding:20rpx 22rpx;margin-top:8rpx}
.id-label{font-size:22rpx;color:var(--muted)}
.id-value{font-size:22rpx;color:var(--ink);word-break:break-all;margin-top:8rpx;font-family:monospace}
.hint{font-size:22rpx;color:var(--muted);text-align:center;margin-top:14rpx;line-height:1.6}

/* 默认学科卡 */
.subj-card{padding:24rpx 26rpx}
.subj-line{display:flex;align-items:baseline;gap:14rpx;flex-wrap:wrap}
.subj-label{font-size:27rpx;font-weight:700;color:var(--ink)}
.subj-note{font-size:21rpx;color:var(--muted)}
.subj-quick{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:16rpx}
.subj-q{padding:10rpx 24rpx;border-radius:20rpx;background:#f0f2f8;color:var(--muted);font-size:22rpx;font-weight:600}
.subj-q.on{background:linear-gradient(90deg,var(--brand),var(--brand2));color:#fff}

/* 三种导入方式：纵向全宽卡片 */
.import-list{display:flex;flex-direction:column;gap:18rpx}
.import-item{display:flex;align-items:center;gap:22rpx;background:#fff;border-radius:24rpx;padding:26rpx 24rpx;box-shadow:0 8rpx 30rpx rgba(40,45,90,.06);border:2rpx solid transparent;transition:transform .1s}
.import-item:active{transform:scale(.98)}
.import-item.disabled{opacity:.55}
.ii-ic{width:88rpx;height:88rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;font-size:44rpx;flex-shrink:0}
.ic-cam{background:linear-gradient(135deg,#eef0ff,#dfe4ff)}
.ic-pdf{background:linear-gradient(135deg,#fff0e8,#ffe2d2)}
.ic-xls{background:linear-gradient(135deg,#e4faf4,#cff3e8)}
.ii-body{flex:1;min-width:0}
.ii-t{font-size:30rpx;font-weight:800;color:var(--ink)}
.ii-d{font-size:22rpx;color:var(--muted);margin-top:8rpx;line-height:1.5}
.ii-arrow{font-size:52rpx;color:#c3c8dc;line-height:1;flex-shrink:0}
.link-row{text-align:center;font-size:23rpx;color:var(--brand);font-weight:600;padding:24rpx 0 8rpx}

/* 用户管理列表 */
.user-list{display:flex;flex-direction:column}
.user-row{display:flex;align-items:center;gap:20rpx;padding:20rpx 0;border-bottom:2rpx solid var(--line)}
.user-row:last-child{border:none}
.u-av{width:88rpx;height:88rpx;border-radius:50%;flex-shrink:0;background:#eef0f8}
.u-av-ph{display:flex;align-items:center;justify-content:center;font-size:44rpx;background:linear-gradient(135deg,#eef0ff,#e4e9ff)}
.u-info{flex:1;min-width:0}
.u-name{font-size:27rpx;font-weight:700;color:#2b3050}
.u-role{font-size:18rpx;color:#fff;background:#5b6cf6;padding:2rpx 12rpx;border-radius:16rpx;margin-left:8rpx;font-weight:600}
.u-meta{font-size:21rpx;color:var(--muted);margin-top:6rpx}
/* 试卷管理：与试卷中心同款筛选面板 */
.filter-panel{background:#fff;border-radius:24rpx;padding:8rpx 24rpx 12rpx;margin:8rpx 0 16rpx;box-shadow:0 8rpx 30rpx rgba(40,45,90,.06)}
.frow{display:flex;align-items:flex-start;gap:18rpx;padding:18rpx 0;border-bottom:2rpx solid #f0f1f6}
.frow:last-child{border-bottom:none}
.frow-lb{flex-shrink:0;width:76rpx;font-size:25rpx;font-weight:700;color:#3a4060;line-height:48rpx}
.chips{display:flex;flex-wrap:wrap;gap:12rpx;flex:1;min-width:0}
.chip{padding:10rpx 22rpx;border-radius:18rpx;background:#f0f2f8;color:#6a7192;font-size:23rpx;line-height:28rpx;white-space:nowrap}
.chip.on{background:linear-gradient(90deg,var(--brand),var(--brand2));color:#fff;font-weight:700}
.filter-reset{font-size:23rpx;color:#5b6cf6;text-align:right;margin:-6rpx 4rpx 14rpx}
/* 试卷管理：与试卷中心同款试卷行（图标 + 标题 + 两行元数据 + 右侧按钮列） */
.lib-card{padding:6rpx 24rpx}
.lib-group{border-bottom:2rpx solid var(--line);padding:20rpx 0}
.lib-group:last-child{border-bottom:none}
.lib-paper{display:flex;align-items:center;gap:16rpx}
.lib-thumb{width:88rpx;height:108rpx;border-radius:14rpx;display:flex;align-items:center;justify-content:center;font-size:40rpx;flex-shrink:0}
.lib-info{flex:1;min-width:0}
.lib-t2{font-size:26rpx;font-weight:700;line-height:1.45;word-break:break-all}
.lib-sp{font-size:22rpx;color:var(--muted);margin-top:6rpx}
.lib-meta2{font-size:20rpx;color:#7c83a4;margin-top:6rpx;line-height:1.5;word-break:break-all}
.lib-del{flex-shrink:0;font-size:23rpx;color:#d92d20;border:2rpx solid #f3c2bd;border-radius:999rpx;padding:8rpx 18rpx;background:#fff5f4}
.lib-ops{flex-shrink:0;display:flex;flex-direction:column;gap:10rpx;align-items:stretch}
.lib-promote{font-size:23rpx;color:#4353d6;border:2rpx solid #c3caf5;border-radius:999rpx;padding:8rpx 18rpx;background:#eef0fe;text-align:center}
.lib-qs{margin-top:12rpx;background:var(--soft);border-radius:14rpx;padding:8rpx 16rpx}
.lib-q{display:flex;align-items:center;gap:14rpx;padding:12rpx 0}
.lib-qwrap{border-bottom:2rpx solid var(--line)}
.lib-qwrap:last-child{border-bottom:none}
.lib-q-stem{flex:1;font-size:23rpx;color:var(--text);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.lib-q-del{flex-shrink:0;font-size:22rpx;color:#d92d20}
.lib-edit{font-size:23rpx;color:#4353d6;border:2rpx solid #c3caf5;border-radius:999rpx;padding:8rpx 18rpx;background:#eef0fe;text-align:center}
/* 元数据编辑面板 */
.meta-panel{background:#f7f8fc;border:2rpx solid #e6e8f2;border-radius:20rpx;padding:20rpx 22rpx;margin:6rpx 0 16rpx}
.meta-row{display:flex;align-items:center;gap:14rpx;margin-bottom:16rpx}
.meta-row:last-of-type{margin-bottom:6rpx}
.meta-k{font-size:24rpx;color:#6a7192;width:110rpx;flex-shrink:0}
.meta-inp{flex:1;min-height:64rpx;padding:12rpx 16rpx;font-size:25rpx}
.meta-year{width:170rpx;min-height:64rpx;padding:12rpx 16rpx;font-size:25rpx;flex-shrink:0}
.meta-picker{flex-shrink:0}
.meta-picker-v{font-size:25rpx;color:#2b3050;background:#fff;border:1rpx solid #e6e8f2;border-radius:14rpx;padding:14rpx 18rpx}
.meta-actions{display:flex;justify-content:flex-end;gap:16rpx;margin-top:10rpx}
.meta-cancel{font-size:25rpx;color:#6a7192;padding:12rpx 26rpx}
.meta-save{font-size:25rpx;font-weight:700;color:#fff;background:linear-gradient(90deg,var(--brand),var(--brand2));border-radius:999rpx;padding:12rpx 30rpx}
/* 题目详情展开区 */
.lib-detail{background:#f7f8fc;border-radius:16rpx;padding:18rpx 20rpx;margin:2rpx 0 14rpx}
.ld-stem{font-size:25rpx;color:#2b3050;line-height:1.55;margin-bottom:10rpx}
.ld-opt{font-size:24rpx;color:#4a5070;line-height:1.5;padding:4rpx 0}
.ld-opt.ok{color:#12987f;font-weight:600}
.ld-ok{color:#12987f}
.ld-line{font-size:24rpx;color:#4a5070;line-height:1.55;margin-top:8rpx}
.ld-k{color:#8992ab;margin-right:10rpx}
.ld-actions{display:flex;align-items:center;gap:18rpx;margin-top:14rpx}
.ld-edit{font-size:24rpx;font-weight:700;color:#4353d6;background:#eef0fe;border-radius:999rpx;padding:10rpx 26rpx}
.ld-note{font-size:21rpx;color:#a0a6bd;flex:1}
.seg{display:flex;background:#e8eaf3;border-radius:20rpx;padding:6rpx;margin:8rpx 0 24rpx}
.seg-i{flex:1;text-align:center;padding:16rpx 0;font-size:26rpx;color:var(--muted);border-radius:14rpx;font-weight:600}
.seg-i.on{background:#fff;color:var(--ink);font-weight:800}
.u-admin-n{font-size:22rpx;color:var(--muted);font-weight:500}
.u-search{margin:6rpx 0 10rpx}
.u-search-inp{background:#f5f6fb;border:1rpx solid #e6e8f2;border-radius:14rpx;padding:18rpx 20rpx;font-size:26rpx;min-height:72rpx;box-sizing:border-box;width:100%;color:#2b3050}
.u-self{font-size:18rpx;color:var(--muted);background:var(--soft);padding:2rpx 12rpx;border-radius:16rpx;margin-left:8rpx;font-weight:600}
.u-ops{display:flex;flex-direction:column;gap:10rpx;flex-shrink:0;align-items:flex-end}
.u-op{font-size:22rpx;font-weight:600;padding:10rpx 18rpx;border-radius:12rpx}
.u-op.set{background:#eef0ff;color:var(--brand)}
.u-op.cancel{background:#ffe9ec;color:var(--red)}
.u-op.papers{background:var(--soft);color:var(--muted)}
.owner-bar{display:flex;align-items:center;justify-content:space-between;background:#eef0ff;color:var(--brand);border-radius:16rpx;padding:16rpx 22rpx;font-size:24rpx;font-weight:600;margin-bottom:18rpx}
.owner-clear{color:var(--muted);font-weight:500}
