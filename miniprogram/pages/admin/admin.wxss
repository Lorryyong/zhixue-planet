.notice{background:#e4faf4;color:#12987f;font-size:24rpx;padding:18rpx 24rpx;border-radius:18rpx;margin-bottom:20rpx;font-weight:600}
.id-box{background:#f7f8fc;border-radius:18rpx;padding:20rpx 22rpx;margin-top:8rpx}
.id-label{font-size:22rpx;color:var(--muted)}
.id-value{font-size:22rpx;color:var(--ink);word-break:break-all;margin-top:8rpx;font-family:monospace}
.hint{font-size:22rpx;color:var(--muted);text-align:center;margin-top:14rpx;line-height:1.6}

/* 默认学科卡 */
.subj-card{padding:24rpx 26rpx}
.subj-line{display:flex;align-items:baseline;gap:14rpx;flex-wrap:wrap}
.subj-label{font-size:27rpx;font-weight:700;color:var(--ink)}
.subj-note{font-size:21rpx;color:var(--muted)}
.subj-quick{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:16rpx}
.subj-q{padding:10rpx 24rpx;border-radius:20rpx;background:#f0f2f8;color:var(--muted);font-size:22rpx;font-weight:600}
.subj-q.on{background:linear-gradient(90deg,var(--brand),var(--brand2));color:#fff}

/* 三种导入方式：纵向全宽卡片 */
.import-list{display:flex;flex-direction:column;gap:18rpx}
.import-item{display:flex;align-items:center;gap:22rpx;background:#fff;border-radius:24rpx;padding:26rpx 24rpx;box-shadow:0 8rpx 30rpx rgba(40,45,90,.06);border:2rpx solid transparent;transition:transform .1s}
.import-item:active{transform:scale(.98)}
.import-item.disabled{opacity:.55}
.ii-ic{width:88rpx;height:88rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;font-size:44rpx;flex-shrink:0}
.ic-cam{background:linear-gradient(135deg,#eef0ff,#dfe4ff)}
.ic-pdf{background:linear-gradient(135deg,#fff0e8,#ffe2d2)}
.ic-xls{background:linear-gradient(135deg,#e4faf4,#cff3e8)}
.ii-body{flex:1;min-width:0}
.ii-t{font-size:30rpx;font-weight:800;color:var(--ink)}
.ii-d{font-size:22rpx;color:var(--muted);margin-top:8rpx;line-height:1.5}
.ii-arrow{font-size:52rpx;color:#c3c8dc;line-height:1;flex-shrink:0}
.link-row{text-align:center;font-size:23rpx;color:var(--brand);font-weight:600;padding:24rpx 0 8rpx}

/* 用户管理列表 */
.user-list{display:flex;flex-direction:column}
.user-row{display:flex;align-items:center;gap:20rpx;padding:20rpx 0;border-bottom:2rpx solid var(--line)}
.user-row:last-child{border:none}
.u-av{width:88rpx;height:88rpx;border-radius:50%;flex-shrink:0;background:#eef0f8}
.u-av-ph{display:flex;align-items:center;justify-content:center;font-size:44rpx;background:linear-gradient(135deg,#eef0ff,#e4e9ff)}
.u-info{flex:1;min-width:0}
.u-name{font-size:27rpx;font-weight:700;color:#2b3050}
.u-role{font-size:18rpx;color:#fff;background:#5b6cf6;padding:2rpx 12rpx;border-radius:16rpx;margin-left:8rpx;font-weight:600}
.u-meta{font-size:21rpx;color:var(--muted);margin-top:6rpx}
.lib-list{margin-top:10rpx}
.lib-group{border-bottom:2rpx solid var(--line);padding:16rpx 0}
.lib-row{display:flex;align-items:center;gap:16rpx}
.lib-info{flex:1;min-width:0}
.lib-t{font-size:27rpx;font-weight:700}
.lib-meta{font-size:22rpx;color:var(--muted);margin-top:4rpx;word-break:break-all}
.lib-del{flex-shrink:0;font-size:23rpx;color:#d92d20;border:2rpx solid #f3c2bd;border-radius:999rpx;padding:8rpx 18rpx;background:#fff5f4}
.lib-qs{margin-top:12rpx;background:var(--soft);border-radius:14rpx;padding:8rpx 16rpx}
.lib-q{display:flex;align-items:center;gap:14rpx;padding:12rpx 0;border-bottom:2rpx solid var(--line)}
.lib-q:last-child{border-bottom:none}
.lib-q-stem{flex:1;font-size:23rpx;color:var(--text);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.lib-q-del{flex-shrink:0;font-size:22rpx;color:#d92d20}
